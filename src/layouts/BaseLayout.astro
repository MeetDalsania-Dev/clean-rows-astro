---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />

  <title>{title || 'Clean Rows | B2B Prospect Lists Built for Your ICP'}</title>
  <meta name="description" content={description || 'ICP-based B2B prospect lists for enterprise, SaaS and agency teams.'} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Inter:wght@300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/site.css?v=13">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div id="reading-progress" aria-hidden="true"></div>
  
  <header class="header">
    <a class="logo" href="/#top" aria-label="Clean Rows home">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <nav id="menu" aria-label="Primary">
      <a href="/for/agencies">For Agencies</a>
      <a href="/lists/ceos">CEO Lists</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
    </nav>
    <div class="cta-pair header-actions">
      <a class="button lime cta-primary" data-sample href="/#contact">Get 100 free leads</a>
      <a class="button cta-secondary" href="/#pricing">Choose a plan</a>
    </div>
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Open navigation">☰</button>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <a class="logo" href="/#top">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <p>ICP-based B2B data for LinkedIn, email and account-based prospecting.<br>Professionally researched prospect data, built around your target markets.</p>
    <div class="footer-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 2rem; margin: 2rem 0; width: 100%;">
      <div class="footer-col">
        <strong>Use Cases</strong>
        <a href="/for/agencies" style="display:block; margin-top:0.5rem;">Marketing Agencies</a>
        <a href="/for/saas" style="display:block; margin-top:0.5rem;">B2B SaaS</a>
        <a href="/for/recruitment" style="display:block; margin-top:0.5rem;">Recruitment</a>
      </div>
      <div class="footer-col">
        <strong>Target Lists</strong>
        <a href="/lists/ceos" style="display:block; margin-top:0.5rem;">CEOs & Founders</a>
        <a href="/lists/vp-sales" style="display:block; margin-top:0.5rem;">VP of Sales</a>
        <a href="/lists/fintech" style="display:block; margin-top:0.5rem;">Fintech Companies</a>
      </div>
      <div class="footer-col">
        <strong>Compare</strong>
        <a href="/compare/apollo" style="display:block; margin-top:0.5rem;">vs Apollo.io</a>
        <a href="/compare/zoominfo" style="display:block; margin-top:0.5rem;">vs ZoomInfo</a>
      </div>
      <div class="footer-col">
        <strong>Company</strong>
        <a href="/about" style="display:block; margin-top:0.5rem;">About Us</a>
        <a href="/pricing" style="display:block; margin-top:0.5rem;">Pricing</a>
        <a href="/whats-in-the-file" style="display:block; margin-top:0.5rem;">Data Fields</a>
        <a href="/data-sources" style="display:block; margin-top:0.5rem;">Data Sources</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Clean Rows.</span>
      <div>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/refund">Refund</a>
        <a href="/gdpr">GDPR</a>
      </div>
    </div>
  </footer>

  <script is:inline src="/content.js?v=8"></script>
  <script is:inline src="/site-ui.js?v=7"></script>
  <script is:inline src="/tracking.js?v=1"></script>
  <script is:inline src="/app.js?v=12"></script>
</body>
</html>
