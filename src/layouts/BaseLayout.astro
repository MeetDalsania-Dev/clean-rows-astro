---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { founder } from '../data/founder';
import { getPosts } from '../lib/blog';
// Cache-busting URL for a file in public/: the query is a hash of its contents,
// so long-lived caching is safe and no version number has to be bumped by hand.
const asset = (path: string) => path + '?v=' + createHash('sha1').update(readFileSync(join(process.cwd(), 'public', path))).digest('hex').slice(0, 10);
const { title, description, editorial = false, schema = [], planHref, bodyClass, mainClass, scripts = editorial ? 'editorial' : 'home', noindex = false, sampleHref, ogType = 'website', ogImage } = Astro.props;
const hasBlog = (await getPosts()).length > 0;
const origin = Astro.site || new URL('https://www.cleanrowsdata.com');
const og = ogImage || { src: new URL('/og-image.png', origin).href, width: 1200, height: 630, alt: 'Clean Rows: custom B2B prospect lists, built to your ICP and priced per list.' };
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', origin).href;
const current = (href: string) => (editorial && Astro.url.pathname.replace(/\/$/, '') === href ? 'page' : undefined);
const pageTitle = title || 'Clean Rows | B2B Prospect Lists Built for Your ICP';
const pageDescription = description || 'ICP-based B2B prospect lists for enterprise, SaaS and agency teams.';
// Editorial pages describe their own WebSite node; other pages get a minimal one.
const website = { '@type': 'WebSite', '@id': new URL('/#website', origin).href, name: 'Clean Rows', url: origin.href, publisher: { '@id': new URL('/#organization', origin).href } };
const graph = [
  { '@type': 'Organization', '@id': new URL('/#organization', origin).href, name: 'Clean Rows', url: origin.href, email: 'hello@cleanrowsdata.com', logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', origin).href, width: 180, height: 180 }, ...(founder.verified ? { founder: { '@type': 'Person', name: founder.name, jobTitle: founder.role, ...(founder.linkedin ? { sameAs: [founder.linkedin] } : {}) } } : {}) },
  ...(schema.some((node: { '@type'?: string }) => node['@type'] === 'WebSite') ? [] : [website]),
  ...schema,
];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Clean Rows" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og.src} />
  <meta property="og:image:width" content={String(og.width)} />
  <meta property="og:image:height" content={String(og.height)} />
  <meta property="og:image:alt" content={og.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og.src} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Self-hosted fonts load after the page has rendered, so they never delay the first paint.
       Once a visitor has them cached, they load immediately on later pages. -->
  <script is:inline>
    (function () {
      var faces = [
        ['Manrope', '/fonts/manrope.woff2', '200 800'],
        ['Inter', '/fonts/inter.woff2', '100 900'],
        ['JetBrains Mono', '/fonts/jetbrains-mono.woff2', '100 800']
      ];
      function loadFonts() {
        if (!('fonts' in document) || typeof FontFace !== 'function') return;
        faces.forEach(function (f) {
          var face = new FontFace(f[0], 'url(' + f[1] + ') format("woff2")', { weight: f[2], display: 'swap' });
          document.fonts.add(face);
          face.load().then(function () {
            try { localStorage.setItem('cr_fonts', '1'); } catch (e) {}
          }, function () {});
        });
      }
      var cached = false;
      try { cached = localStorage.getItem('cr_fonts') === '1'; } catch (e) {}
      // First visit: start the font downloads only after the page has painted.
      function afterFirstPaint() {
        var done = false;
        function go() { if (!done) { done = true; setTimeout(loadFonts, 100); } }
        try {
          new PerformanceObserver(function (list) {
            if (list.getEntriesByName('first-contentful-paint').length) go();
          }).observe({ type: 'paint', buffered: true });
        } catch (e) {}
        setTimeout(go, 1500);
      }
      if (cached) loadFonts();
      else addEventListener('load', afterFirstPaint);
    })();
  </script>
  <noscript><style>
    @font-face{font-family:Manrope;src:url(/fonts/manrope.woff2) format("woff2");font-weight:200 800;font-display:swap}
    @font-face{font-family:Inter;src:url(/fonts/inter.woff2) format("woff2");font-weight:100 900;font-display:swap}
    @font-face{font-family:"JetBrains Mono";src:url(/fonts/jetbrains-mono.woff2) format("woff2");font-weight:100 800;font-display:swap}
  </style></noscript>

  <style is:inline set:html={readFileSync(join(process.cwd(), 'public', 'site.css'), 'utf-8')}></style>
  {editorial && <style is:inline set:html={readFileSync(join(process.cwd(), 'public', 'editorial.css'), 'utf-8')}></style>}
  
  <!-- Google Analytics 4 with Consent Mode: no analytics cookies until the visitor accepts in the cookie banner. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    var crConsent = null;
    try { crConsent = localStorage.getItem('cr_consent'); } catch (e) {}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: crConsent === 'granted' ? 'granted' : 'denied'
    });
    gtag('js', new Date());
    gtag('config', 'G-HH1KL43KHB');
    
    let gaLoaded = false;
    function loadGA() {
      if (gaLoaded) return;
      gaLoaded = true;
      const script = document.createElement('script');
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HH1KL43KHB';
      script.async = true;
      document.head.appendChild(script);
    }
    setTimeout(loadGA, 4000);
    ['scroll','mousemove','touchstart','keydown'].forEach(e => window.addEventListener(e, loadGA, {once: true, passive: true}));
  </script>
  <link rel="alternate" type="application/rss+xml" title="Clean Rows blog" href="/rss.xml" />
  <slot name="head" />
</head>
<body class:list={[bodyClass, { editorial }]}>
  <a class="skip" href="#main">Skip to content</a>
  <div id="reading-progress" aria-hidden="true"></div>
  
  <header class="header">
    <a class="logo" href="/#top" aria-label="cleanrows home">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <nav id="menu" aria-label="Primary">
      <a href="/for/agencies" aria-current={current('/for/agencies')}>For Agencies</a>
      <a href="/services/custom-lists" aria-current={current('/services/custom-lists')}>Services</a>
      <a href="/pricing" aria-current={current('/pricing')}>Pricing</a>
      <a href="/about" aria-current={current('/about')}>About</a>
    </nav>
    <div class="cta-pair header-actions">
      <a class="button lime cta-primary" data-sample href={sampleHref || (editorial ? '#contact' : '/#contact')}>Get 100 free leads</a>
      <a class="button cta-secondary" href={planHref || (editorial ? (Astro.url.pathname.replace(/\/$/, '') === '/pricing' ? '#pricing' : '/pricing') : '/#pricing')}>Choose a plan</a>
    </div>
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Open navigation">☰</button>
  </header>

  <main id="main" class={mainClass}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-brand">
    <a class="logo" href="/#top">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <p>ICP-based B2B data for LinkedIn, email and account-based prospecting.<br>Professionally researched prospect data, built around your target markets.</p>
    </div>
    <nav class="footer-grid" aria-label="Footer">
      <div class="footer-col">
        <strong>Use Cases</strong>
        <a href="/for/agencies">Agencies</a>
        <a href="/for/saas">B2B SaaS</a>
        <a href="/for/recruitment">Recruitment</a>
      </div>
      <div class="footer-col">
        <strong>Popular Lists</strong>
        <a href="/lists/ceos">CEOs & Founders</a>
        <a href="/lists/vp-sales">VP of Sales</a>
        <a href="/lists/fintech">Fintech Companies</a>
      </div>
      <div class="footer-col">
        <strong>Company</strong>
        <a href="/about">About Us</a>
        <a href="/pricing">Pricing</a>
        <a href="/whats-in-the-file">Data Fields</a>
        <a href="/data-sources">Data Sources</a>
        {hasBlog && <a href="/blog">Blog</a>}
        <a href="/compare/b2b-data-subscriptions">Lists vs Subscriptions</a>
      </div>
    </nav>
    <div class="footer-bottom">
      <span>© 2026 Clean Rows.</span>
      <div>
        <button type="button" class="cookie-settings" data-cookie-settings>Cookie settings</button>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/refund">Refund</a>
        <a href="/gdpr">GDPR</a>
      </div>
    </div>
  </footer>

  <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie preferences" hidden>
    <p><strong>Can we use analytics cookies?</strong> They show us which pages help visitors. No advertising cookies. See our <a href="/privacy#cookies">Privacy Policy</a>.</p>
    <div class="cookie-actions">
      <button type="button" class="button" data-consent="denied">Reject</button>
      <button type="button" class="button" data-consent="granted">Accept</button>
    </div>
  </div>

  {/* Page scripts: 'home' (content + app), 'editorial', 'calculator' or 'none' (legal pages). */}
  {scripts === 'home' && <script is:inline defer src={asset("/content.js")}></script>}
  <script is:inline defer src={asset("/site-ui.js")}></script>
  <script is:inline defer src={asset("/tracking.js")}></script>
  {scripts === 'home' && <script is:inline defer src={asset("/app.js")}></script>}
  {scripts === 'editorial' && <script is:inline defer src={asset("/editorial.js")}></script>}
  {scripts === 'calculator' && <script is:inline defer src={asset("/calculator.js")}></script>}
</body>
</html>
