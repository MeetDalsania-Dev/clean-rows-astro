---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { founder } from '../data/founder';
import { getPosts } from '../lib/blog';
import Clarity from '../components/Clarity.astro';
// Cache-busting URL for a file in public/: the query is a hash of its contents,
// so long-lived caching is safe and no version number has to be bumped by hand.
const asset = (path: string) => path + '?v=' + createHash('sha1').update(readFileSync(join(process.cwd(), 'public', path))).digest('hex').slice(0, 10);
const { title, description, editorial = false, schema = [], planHref, bodyClass, mainClass, scripts = editorial ? 'editorial' : 'home', noindex = false, sampleHref, ogType = 'website', ogImage } = Astro.props;
const hasBlog = (await getPosts()).length > 0;
const origin = Astro.site || new URL('https://www.cleanrowsdata.com');
const og = ogImage || { src: new URL('/og-image.png', origin).href, width: 1200, height: 630, alt: 'Clean Rows: custom B2B prospect lists, built to your ICP and priced per list.' };
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', origin).href;
const current = (href: string) => (editorial && Astro.url.pathname.replace(/\/$/, '') === href ? 'page' : undefined);
const pageTitle = title || 'Clean Rows | B2B Prospect Lists Built for Your ICP';
const pageDescription = description || 'ICP based B2B prospect lists for enterprise, SaaS and agency teams.';
// Official social profiles, one entry each. The Organization schema sameAs and
// the footer column both render straight from this list.
const social = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/company/cleanrowsdata/' },
  { name: 'Instagram', url: 'https://www.instagram.com/cleanrowsdata/' },
  { name: 'X', url: 'https://x.com/cleanrowsdata' },
];
const activeSocial = social.filter((s) => s.url);
// Editorial pages describe their own WebSite node; other pages get a minimal one.
const website = { '@type': 'WebSite', '@id': new URL('/#website', origin).href, name: 'Clean Rows', url: origin.href, publisher: { '@id': new URL('/#organization', origin).href } };
const graph = [
  { '@type': 'Organization', '@id': new URL('/#organization', origin).href, name: 'Clean Rows', alternateName: ['Clean Rows Data', 'cleanrowsdata'], url: origin.href, email: 'sales@cleanrowsdata.com', logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', origin).href, width: 180, height: 180 }, sameAs: activeSocial.map((s) => s.url), ...(founder.verified ? { founder: { '@type': 'Person', name: founder.name, jobTitle: founder.role, ...(founder.linkedin ? { sameAs: [founder.linkedin] } : {}) } } : {}) },
  ...(schema.some((node: { '@type'?: string }) => node['@type'] === 'WebSite') ? [] : [website]),
  ...schema,
];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Clean Rows" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og.src} />
  <meta property="og:image:width" content={String(og.width)} />
  <meta property="og:image:height" content={String(og.height)} />
  <meta property="og:image:alt" content={og.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og.src} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- The LCP element on the main pages is the Manrope H1. Preload that face and
       declare it with swap so first-paint text renders in it without waiting for
       the post-load script below; Inter and JetBrains Mono still load lazily. -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/manrope.woff2" />
  <style is:inline>
    @font-face{font-family:Manrope;src:url(/fonts/manrope.woff2) format("woff2");font-weight:200 800;font-display:swap}
  </style>

  <!-- Self-hosted fonts load after the page has rendered, so they never delay the first paint.
       Once a visitor has them cached, they load immediately on later pages. -->
  <script is:inline>
    (function () {
      var faces = [
        ['Manrope', '/fonts/manrope.woff2', '200 800'],
        ['Inter', '/fonts/inter.woff2', '100 900'],
        ['JetBrains Mono', '/fonts/jetbrains-mono.woff2', '100 800']
      ];
      function loadFonts() {
        if (!('fonts' in document) || typeof FontFace !== 'function') return;
        faces.forEach(function (f) {
          var face = new FontFace(f[0], 'url(' + f[1] + ') format("woff2")', { weight: f[2], display: 'swap' });
          document.fonts.add(face);
          face.load().then(function () {
            try { localStorage.setItem('cr_fonts', '1'); } catch (e) {}
          }, function () {});
        });
      }
      var cached = false;
      try { cached = localStorage.getItem('cr_fonts') === '1'; } catch (e) {}
      // First visit: start the font downloads only after the page has painted.
      function afterFirstPaint() {
        var done = false;
        function go() { if (!done) { done = true; setTimeout(loadFonts, 100); } }
        try {
          new PerformanceObserver(function (list) {
            if (list.getEntriesByName('first-contentful-paint').length) go();
          }).observe({ type: 'paint', buffered: true });
        } catch (e) {}
        setTimeout(go, 1500);
      }
      if (cached) loadFonts();
      else addEventListener('load', afterFirstPaint);
    })();
  </script>
  <noscript><style>
    @font-face{font-family:Manrope;src:url(/fonts/manrope.woff2) format("woff2");font-weight:200 800;font-display:swap}
    @font-face{font-family:Inter;src:url(/fonts/inter.woff2) format("woff2");font-weight:100 900;font-display:swap}
    @font-face{font-family:"JetBrains Mono";src:url(/fonts/jetbrains-mono.woff2) format("woff2");font-weight:100 800;font-display:swap}
  </style></noscript>

  <style is:inline set:html={readFileSync(join(process.cwd(), 'public', 'site.css'), 'utf-8')}></style>
  {editorial && <style is:inline set:html={readFileSync(join(process.cwd(), 'public', 'editorial.css'), 'utf-8')}></style>}
  {Astro.url.pathname.startsWith('/b2b-data/uk') && <style is:inline set:html={readFileSync(join(process.cwd(), 'public', 'uk.astro.css'), 'utf-8')}></style>}
  
  <!-- Google Analytics 4 with Consent Mode: no analytics cookies until the visitor accepts in the cookie banner. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    var crConsent = null;
    try { crConsent = localStorage.getItem('cr_consent'); } catch (e) {}
    // A choice made in the client portal (app.cleanrowsdata.com) arrives as a shared cookie.
    if (crConsent !== 'granted' && crConsent !== 'denied') {
      var crShared = document.cookie.match(/(?:^|;\s*)cr_consent=(granted|denied)/);
      if (crShared) { crConsent = crShared[1]; try { localStorage.setItem('cr_consent', crConsent); } catch (e) {} }
    }
    // And a choice made here, before the cookie existed, is shared with the portal too.
    else if (location.hostname.endsWith('cleanrowsdata.com') && document.cookie.indexOf('cr_consent=') === -1) {
      document.cookie = 'cr_consent=' + crConsent + '; Domain=.cleanrowsdata.com; Path=/; Max-Age=31536000; SameSite=Lax; Secure';
    }
    // Internal traffic flag. Our ISP changes IPs, so IP filters in the GA property go
    // stale; instead the owner can mark their own visits with ?internal=1 (remembered
    // locally) and clear it with ?internal=0. Flagged visits are sent to GA as
    // traffic_type "internal" and filtered out of reports.
    var crInternal = null;
    try { crInternal = localStorage.getItem('cr_internal'); } catch (e) {}
    var crInternalParam = new URLSearchParams(location.search).get('internal');
    if (crInternalParam === '1') { try { localStorage.setItem('cr_internal', '1'); } catch (e) {} crInternal = '1'; }
    else if (crInternalParam === '0') { try { localStorage.removeItem('cr_internal'); } catch (e) {} crInternal = null; }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: crConsent === 'granted' ? 'granted' : 'denied'
    });
    gtag('js', new Date());
    gtag('config', 'G-HH1KL43KHB', crInternal === '1' ? { traffic_type: 'internal' } : {});
    
    let gaLoaded = false;
    function loadGA() {
      if (gaLoaded) return;
      gaLoaded = true;
      const script = document.createElement('script');
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HH1KL43KHB';
      script.async = true;
      document.head.appendChild(script);
    }
    // Loaded as soon as the page has finished loading (not after a fixed delay), so quick visits
    // are counted while GA still never competes with the page's own files for the first paint.
    if (document.readyState === 'complete') loadGA();
    else window.addEventListener('load', loadGA, {once: true});
    ['scroll','mousemove','touchstart','keydown'].forEach(e => window.addEventListener(e, loadGA, {once: true, passive: true}));
  </script>
  <Clarity />
  <link rel="alternate" type="application/rss+xml" title="Clean Rows blog" href="/rss.xml" />
  <slot name="head" />
</head>
<body class:list={[bodyClass, { editorial }]}>
  <a class="skip" href="#main">Skip to content</a>
  <script is:inline>
    // Offscreen sections skip rendering (content-visibility). Render them all before an
    // in-page jump such as #contact, so the scroll target position is exact.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#"]');
      if (a && a.pathname === location.pathname) document.documentElement.classList.add('cv-off');
    }, true);
  </script>
  <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie preferences" hidden>
    <p><strong>Can we use analytics cookies?</strong> They show us which pages help visitors. No advertising cookies. See our <a href="/privacy#cookies">Privacy Policy</a>.</p>
    <div class="cookie-actions">
      <button type="button" class="button" data-consent="denied">Reject</button>
      <button type="button" class="button" data-consent="granted">Accept</button>
    </div>
  </div>
  <script is:inline>
    // Show the banner in the first paint when no choice is stored (site-ui.js handles the buttons).
    (function () { var c = null; try { c = localStorage.getItem('cr_consent'); } catch (e) {} if (c !== 'granted' && c !== 'denied') document.getElementById('cookie-banner').hidden = false; })();
  </script>
  <div id="reading-progress" aria-hidden="true"></div>
  
  <header class="header">
    <a class="logo" href="/#top" aria-label="cleanrows home">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <nav id="menu" aria-label="Primary">
      <a href="/for/agencies" aria-current={current('/for/agencies')}>For Agencies</a>
      <a href="/services/custom-lists" aria-current={current('/services/custom-lists')}>Services</a>
      <a href="/pricing" aria-current={current('/pricing')}>Pricing</a>
      <a href="/about" aria-current={current('/about')}>About</a>
      <a class="nav-login" href="https://app.cleanrowsdata.com/login">Client login</a>
    </nav>
    <div class="cta-pair header-actions">
      <a class="button lime cta-primary" data-sample href={sampleHref || (editorial ? '#contact' : '/#contact')}>Get 100 free leads</a>
      <a class="button cta-secondary" href={planHref || (editorial ? (Astro.url.pathname.replace(/\/$/, '') === '/pricing' ? '#pricing' : '/pricing') : '/#pricing')}>Choose a plan</a>
    </div>
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Open navigation">☰</button>
  </header>

  <main id="main" class={mainClass}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-brand">
    <a class="logo" href="/#top">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <p>ICP based B2B data for LinkedIn, email and account based prospecting.<br>Professionally researched prospect data, built around your target markets.</p>
    </div>
    <nav class="footer-grid" aria-label="Footer">
      <div class="footer-col">
        <strong>Use Cases</strong>
        <a href="/for/agencies">Agencies</a>
        <a href="/for/saas">B2B SaaS</a>
        <a href="/for/recruitment">Recruitment</a>
      </div>
      <div class="footer-col">
        <strong>Popular Lists</strong>
        <a href="/lists/ceos">CEOs & Founders</a>
        <a href="/lists/vp-sales">VP of Sales</a>
        <a href="/lists/fintech">Fintech Companies</a>
      </div>
      <div class="footer-col">
        <strong>Country Data</strong>
        <a href="/b2b-data/uk">UK B2B Data</a>
      </div>
      <div class="footer-col">
        <strong>Free Tools</strong>
        <a href="/tools/cold-email-checker">Cold email checker</a>
        <a href="/calculator">Lead list calculator</a>
      </div>
      {activeSocial.length > 0 && (
        <div class="footer-col">
          <strong>Social</strong>
          {activeSocial.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={`Clean Rows on ${s.name}`}>
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="margin-right:6px;flex-shrink:0">
                {s.name === 'Instagram'
                  ? <><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></>
                  : s.name === 'LinkedIn'
                  ? <path fill="currentColor" d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6 1.12 6 0 4.88 0 3.5 0 2.12 1.12 1 2.5 1c1.37 0 2.48 1.12 2.48 2.5ZM.5 8h4v15h-4V8Zm8 0h3.8v2.5h.05c.53-.9 1.83-2.5 3.97-2.5 4.03 0 4.78 2.5 4.78 5.98V23h-4v-8.6c0-2.05-.04-4.68-2.99-4.68-3.01 0-3.47 2.3-3.47 4.72V23h-4V8Z"/>
                  : <path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26L23 21.75h-6.66l-5.21-6.82-5.96 6.82H1.87l7.73-8.84L1.25 2.25H8.1l4.71 6.23 5.43-6.23Z"/>}
              </svg>
              {s.name}
            </a>
          ))}
        </div>
      )}
      <div class="footer-col">
        <strong>Company</strong>
        <a href="/about">About Us</a>
        <a href="/pricing">Pricing</a>
        <a href="/whats-in-the-file">Data Fields</a>
        <a href="/data-sources">Data Sources</a>
        {hasBlog && <a href="/blog">Blog</a>}
        <a href="/compare/b2b-data-subscriptions">Lists vs Subscriptions</a>
        <a href="https://app.cleanrowsdata.com/login">Client login</a>
      </div>
    </nav>
    <div class="footer-bottom">
      <span>© 2026 Clean Rows.</span>
      <div>
        <button type="button" class="cookie-settings" data-cookie-settings>Cookie settings</button>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/refund">Refund</a>
        <a href="/gdpr">GDPR</a>
      </div>
    </div>
  </footer>



  {/* Page scripts: 'home' (content + app), 'editorial', 'calculator' or 'none' (legal pages).
      site-ui.js is site chrome only (menu, reading progress, cookie consent) and runs
      everywhere. The lead-form behaviour lives in form-ui.js and ships only on the
      pages that render a form, so form-less pages never download it. */}
  {scripts === 'home' && <script is:inline defer src={asset("/content.js")}></script>}
  <script is:inline defer src={asset("/site-ui.js")}></script>
  <script is:inline defer src={asset("/tracking.js")}></script>
  {(scripts === 'home' || scripts === 'editorial') && <script is:inline defer src={asset("/form-ui.js")}></script>}
  {(scripts === 'home' || scripts === 'editorial') && <script is:inline defer src={asset("/form-steps.js")}></script>}
  {scripts === 'home' && <script is:inline defer src={asset("/app.js")}></script>}
  {scripts === 'editorial' && <script is:inline defer src={asset("/editorial.js")}></script>}
  {scripts === 'calculator' && <script is:inline defer src={asset("/calculator.js")}></script>}
</body>
</html>
