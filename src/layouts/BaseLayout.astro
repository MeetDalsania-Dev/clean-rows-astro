---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />

  <title>{title || 'Clean Rows | B2B Prospect Lists Built for Your ICP'}</title>
  <meta name="description" content={description || 'ICP-based B2B prospect lists for enterprise, SaaS and agency teams.'} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Inter:wght@300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/site.css?v=13">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div id="reading-progress" aria-hidden="true"></div>
  
  <header class="header">
    <a class="logo" href="/#top" aria-label="Clean Rows home">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <nav id="menu" aria-label="Primary">
      <a href="/#verify">The difference</a>
      <a href="/#how">How it works</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <div class="cta-pair header-actions">
      <a class="button lime cta-primary" data-sample href="/#contact">Get 100 free leads</a>
      <a class="button cta-secondary" href="/#pricing">Choose a plan</a>
    </div>
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Open navigation">☰</button>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <a class="logo" href="/#top">
      <img src="/mark-emerald-on-dark.svg" width="30" height="30" alt="">cleanrows<span>®</span>
    </a>
    <p>ICP-based B2B data for LinkedIn, email and account-based prospecting.<br>Professionally researched prospect data, built around your target markets.</p>
    <div class="footer-links">
      <a href="/#features">What’s in the file</a>
      <a href="/calculator">Savings calculator</a>
      <a href="/#results">Delivered orders</a>
      <a href="/#about">About</a>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Clean Rows.</span>
      <div>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/refund">Refund</a>
        <a href="/gdpr">GDPR</a>
      </div>
    </div>
  </footer>

  <script is:inline src="/content.js?v=8"></script>
  <script is:inline src="/site-ui.js?v=7"></script>
  <script is:inline src="/tracking.js?v=1"></script>
  <script is:inline src="/app.js?v=12"></script>
</body>
</html>
