---
import BaseLayout from '../../layouts/BaseLayout.astro';

import How from '../../components/How.astro';
import Results from '../../components/Results.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
import Contact from '../../components/Contact.astro';
import Compliance from '../../components/Compliance.astro';
import WhoNotFor from '../../components/WhoNotFor.astro';
import Founder from '../../components/Founder.astro';
import SampleTable from '../../components/SampleTable.astro';

---
<BaseLayout title="B2B Leads for Marketing Agencies | Clean Rows" description="Custom-built B2B prospect lists for marketing agencies. Give your clients the highest quality outbound data.">
<section class="hero" id="top">
<div class="hero-grid"><div class="hero-copy">
<a class="announcement" href="/#pricing"><span>AGENCY PARTNERS</span>White-label files and per-client splits <span aria-hidden="true">↗︎</span></a>
<p class="eyebrow hero-kicker">BETTER DATA. HAPPIER CLIENTS.</p>
<h1>B2B leads for <br><em>Marketing Agencies.</em></h1>
<p class="hero-description">Stop burning your clients' domains with stale database dumps. We build fresh, ICP-verified prospect lists for your clients' cold email and LinkedIn outreach campaigns.</p>
<div class="hero-actions"><div class="cta-pair"><a class="button lime cta-primary" data-sample href="/#contact">Get 100 free leads</a><a class="button cta-secondary" href="/#pricing">Choose a plan</a></div></div>
<p class="micro hero-note">Separate exports for every client campaign.</p>
</div>
<div class="lead-scene" aria-label="Illustrative lead verification process with sample contacts">
<div class="scene-grid" aria-hidden="true"></div><div class="scene-orbit orbit-one" aria-hidden="true"></div><div class="scene-orbit orbit-two" aria-hidden="true"></div>
<div class="scene-brief"><span class="scene-icon" aria-hidden="true">⌕</span><div><small>CLIENT: ACME CORP</small><strong>Right people. Right companies.</strong><p>VP of Sales <span>·</span> B2B SaaS <span>·</span> US + UK</p></div></div>
<div class="scene-file"><div class="file-top"><span class="file-symbol" aria-hidden="true">▤</span><div><strong>acme-campaign.csv</strong><span>10,000 leads · 10 enriched fields</span></div><span class="file-menu" aria-hidden="true">•••</span></div>
<div class="file-columns"><span>YOUR NEXT CONVERSATION</span><span>STATUS</span></div>
<div class="scene-person"><span class="avatar a0">MP</span><div><strong>Maya Patel</strong><small>VP of Sales · Northwind</small></div><span class="person-check" aria-label="Verified">✓</span></div>
<div class="scene-person"><span class="avatar a1">JW</span><div><strong>Jonas Weber</strong><small>CTO · Brightline</small></div><span class="person-check" aria-label="Verified">✓</span></div>
<div class="file-checks"><span>✓ LinkedIn profiles</span><span>✓ Business contacts</span></div><div class="scan-line" aria-hidden="true"></div></div>
</div></div>
<div class="hero-proof"><div><span class="proof-icon" aria-hidden="true">✓</span><p><strong>White-label friendly.</strong><span>Deliver directly to clients.</span></p></div><div><span class="proof-icon" aria-hidden="true">✓</span><p><strong>Pay per client list.</strong><span>No expensive seat licenses.</span></p></div><div><span class="proof-icon" aria-hidden="true">＋</span><p><strong>Check the fit first.</strong><span>100 real leads. Yours to review.</span></p></div></div>
</section>

<section class="section paper" id="who">
<div class="section-heading">
<p class="eyebrow"><span>01</span>AGENCY FOCUS</p>
<h2>Built for multichannel agencies</h2>
<p>You run outbound for multiple clients. You need clean data, separated into specific lists, delivered fast. We handle the data research so you can focus on writing campaigns and booking meetings.</p>
</div>
<div class="audience-panel reveal" style="display:block;">
<div>
<span class="audience-index">01 / AGENCIES</span>
<h3>Agencies running multichannel campaigns</h3>
<p>Build targeted prospect lists for every client, with LinkedIn profiles, company context and business contacts in one file. Separate exports keep client campaigns organised, and per-list pricing keeps costs clear.</p>
</div>
<ul>
<li>Separate export per client or campaign</li>
<li>Lower per-lead rates on larger packages</li>
<li>Priority rebuilds for retainer clients</li>
<li>White-label friendly files</li>
</ul>
</div>
<div class="section-cta"><p>Find out if your clients' target market fits. <strong>Start with a free sample.</strong></p><div class="cta-pair"><a class="button lime cta-primary" data-sample href="/#contact">Get 100 free leads</a><a class="button cta-secondary" href="/#pricing">Choose a plan</a></div></div>
</section>

<How />
<Results />

<Compliance />
<WhoNotFor />
<Founder />

<Pricing />
<FAQ />
<SampleTable />
<Contact />
</BaseLayout>

