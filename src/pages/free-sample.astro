---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
import How from '../components/How.astro';
import Pricing from '../components/Pricing.astro';
import Results from '../components/Results.astro';
import Compliance from '../components/Compliance.astro';
import WhoNotFor from '../components/WhoNotFor.astro';
import Founder from '../components/Founder.astro';
import SampleTable from '../components/SampleTable.astro';
---
<BaseLayout title="Get 100 Free B2B Leads" description="Custom B2B data lists built for your ICP.">


  <section class="hero" id="top">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker">TEST OUR DATA</p>
        <h1>Get 100 Free B2B Leads</h1>
        <p class="hero-description">Send your ICP and get 100 real prospects back within 24 hours. Review the LinkedIn profiles and job titles before you commit to a larger list.</p>
        <div class="hero-actions">
          <div class="cta-pair">
            <a class="button lime cta-primary" href="#contact">Get 100 free leads</a>
          </div>
        </div>
      </div>
    </div>
  </section>
<SampleTable />
<Compliance />
<FAQ />
<Contact />
</BaseLayout>
