---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getPosts, categories, readingMinutes, formatDate, isoDate } from '../../lib/blog';

const posts = await getPosts();
const origin = Astro.site || new URL('https://www.cleanrowsdata.com');
const url = new URL('/blog', origin).href;
const title = 'B2B Prospecting and Lead Data Guides | Clean Rows Blog';
const description =
  'Practical guides on building B2B prospect lists, buying verified email lists and keeping lead data fresh, from the team that researches them.';
const schema = [
  {
    '@type': 'Blog',
    '@id': url,
    url,
    name: 'Clean Rows blog',
    description,
    inLanguage: 'en-US',
    publisher: { '@id': new URL('/#organization', origin).href },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: new URL(`/blog/${post.id}`, origin).href,
      datePublished: isoDate(post.data.publishedDate),
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin.href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} editorial schema={schema} noindex={posts.length === 0}>
  <section class="ed-hero blog-hero">
    <div class="ed-wrap">
      <nav class="ed-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Blog</span>
      </nav>
      <p class="ed-kicker"><span></span>CLEAN ROWS BLOG</p>
      <h1>B2B prospecting and lead data guides</h1>
      <p class="ed-accent">Straight answers, no fluff.</p>
      <p class="ed-intro">
        How to build a B2B prospect list, what to check before you buy B2B data, and how to keep a
        list fresh enough to use.
      </p>
    </div>
  </section>

  <section class="ed-section blog-list" aria-label="Articles">
    <div class="ed-wrap">
      {posts.length === 0 ? (
        <p class="blog-empty">The first guides are on their way. <a class="ed-inline" href="/free-sample">Try 100 free leads</a> in the meantime.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              {post.data.coverImage && (
                <a href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true" class="blog-card-media">
                  <Image src={post.data.coverImage} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 400px" loading="lazy" />
                </a>
              )}
              <p class="ed-kicker">
                {categories[post.data.category].toUpperCase()}
                {post.data.draft && <span class="blog-draft">DRAFT</span>}
              </p>
              <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <p class="blog-meta">
                <time datetime={isoDate(post.data.publishedDate)}>{formatDate(post.data.publishedDate)}</time>
                <span aria-hidden="true">·</span>
                {readingMinutes(post)} min read
              </p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
