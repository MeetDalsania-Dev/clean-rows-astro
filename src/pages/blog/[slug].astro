---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/editorial/FAQ.astro';
import Related from '../../components/editorial/Related.astro';
import Contact from '../../components/Contact.astro';
import { getPosts, getAuthor, categories, readingMinutes, formatDate, isoDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { data } = post;
const { Content } = await render(post);
const author = await getAuthor(post);
const origin = Astro.site || new URL('https://www.cleanrowsdata.com');
const url = new URL(`/blog/${post.id}`, origin).href;
const modified = data.updatedDate ?? data.publishedDate;
const minutes = readingMinutes(post);
const cover = data.coverImage ? await getImage({ src: data.coverImage, width: 1200, format: 'jpg' }) : null;
const faqs = data.faqs.map(({ question, answer }) => [question, answer]);

const authorNode = author
  ? {
      '@type': 'Person',
      name: author.data.name,
      ...(author.data.role ? { jobTitle: author.data.role } : {}),
      ...(author.data.linkedin ? { url: author.data.linkedin, sameAs: [author.data.linkedin] } : {}),
      worksFor: { '@id': new URL('/#organization', origin).href },
    }
  : { '@id': new URL('/#organization', origin).href };

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    mainEntityOfPage: url,
    url,
    headline: data.title,
    description: data.description,
    datePublished: isoDate(data.publishedDate),
    dateModified: isoDate(modified),
    inLanguage: 'en-US',
    articleSection: categories[data.category],
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    author: authorNode,
    publisher: { '@id': new URL('/#organization', origin).href },
    image: cover ? new URL(cover.src, origin).href : new URL('/og-image.png', origin).href,
    isPartOf: { '@id': new URL('/blog', origin).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin.href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', origin).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  ...(faqs.length
    ? [
        {
          '@type': 'FAQPage',
          mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
        },
      ]
    : []),
];

const others = posts.filter((p) => p.id !== post.id);
const related = [
  ...others
    .sort((a, b) => Number(b.data.category === data.category) - Number(a.data.category === data.category))
    .slice(0, 3)
    .map((p) => [`/blog/${p.id}`, p.data.title, p.data.description]),
  ['/free-sample', 'Try 100 free leads', 'A sample built to your ICP before you pay.'],
  ['/services/custom-lists', 'How custom lists work', 'Briefs, feasibility and scope.'],
  ['/pricing', 'Clean Rows pricing', 'One-time packages, no seat fees.'],
].slice(0, 3);
---

<BaseLayout
  title={data.seoTitle || `${data.title} | Clean Rows`}
  description={data.description}
  editorial
  schema={schema}
  ogType="article"
  ogImage={cover ? { src: new URL(cover.src, origin).href, width: cover.attributes.width ?? 1200, height: cover.attributes.height ?? 675, alt: data.coverAlt || data.title } : undefined}
  noindex={data.draft}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(data.publishedDate)} />
    <meta property="article:modified_time" content={isoDate(modified)} />
  </Fragment>
  <article class="blog-post">
    <header class="ed-hero blog-post-hero">
      <div class="ed-wrap blog-narrow">
        <nav class="ed-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{categories[data.category]}</span>
        </nav>
        <p class="ed-kicker">
          <span></span>{categories[data.category].toUpperCase()}
          {data.draft && <span class="blog-draft">DRAFT, NOT PUBLISHED</span>}
        </p>
        <h1>{data.title}</h1>
        <p class="ed-intro">{data.description}</p>
        <p class="blog-meta">
          <span>By {author ? author.data.name : 'the Clean Rows team'}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(data.publishedDate)}>{formatDate(data.publishedDate)}</time>
          {data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>
    {data.coverImage && (
      <figure class="blog-cover ed-wrap blog-wide">
        <Image src={data.coverImage} alt={data.coverAlt || ''} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 900px" loading="eager" fetchpriority="high" />
      </figure>
    )}
    <div class="ed-wrap blog-narrow blog-prose">
      <Content />
    </div>
    <aside class="ed-wrap blog-narrow blog-author" aria-label="About the author">
      {author?.data.photo ? (
        <Image src={author.data.photo} alt="" width={64} height={64} class="blog-author-photo" />
      ) : (
        <span class="blog-author-photo blog-author-mark" aria-hidden="true">CR</span>
      )}
      <div>
        <p class="blog-author-name">
          {author ? author.data.name : 'Clean Rows'}
          {author?.data.role && <span>{author.data.role}</span>}
        </p>
        <p>
          {author?.data.bio ||
            'Clean Rows researches custom B2B prospect lists to each customer’s ICP and checks every file before delivery.'}
        </p>
        {author?.data.linkedin && (
          <a class="ed-inline" href={author.data.linkedin} rel="noopener me" target="_blank">Connect on LinkedIn</a>
        )}
      </div>
    </aside>
  </article>
  {faqs.length > 0 && <FAQ title="Frequently asked questions" items={faqs} />}
  <Contact
    sampleOnly
    team="Other"
    heading="Put it into practice."
    emphasis="Start with 100 leads."
    closing=""
    description="Send your ICP and we’ll build a free 100-lead sample, so you can check the fit before you buy."
  />
  <Related items={related} />
</BaseLayout>
