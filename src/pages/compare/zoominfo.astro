---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import FAQ from '../../components/FAQ.astro';
import How from '../../components/How.astro';
import Pricing from '../../components/Pricing.astro';
import Results from '../../components/Results.astro';
import Compliance from '../../components/Compliance.astro';
import WhoNotFor from '../../components/WhoNotFor.astro';
import Founder from '../../components/Founder.astro';
import SampleTable from '../../components/SampleTable.astro';
import CompareTable from '../../components/CompareTable.astro';
---
<BaseLayout title="Clean Rows vs ZoomInfo" description="Custom B2B data lists built for your ICP.">


  <section class="hero" id="top">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker">THE HONEST COMPARISON</p>
        <h1>Clean Rows vs <em> ZoomInfo</em></h1>
        <p class="hero-description">Avoid 5k annual contracts. See why teams prefer our fresh, verified data over traditional bulk platforms.</p>
        <div class="hero-actions">
          <div class="cta-pair">
            <a class="button lime cta-primary" href="#contact">Get 100 free leads</a>
          </div>
        </div>
      </div>
    </div>
  </section>
<CompareTable competitorName="ZoomInfo" />
<SampleTable />
<Compliance />
<FAQ />
<Contact />
</BaseLayout>
