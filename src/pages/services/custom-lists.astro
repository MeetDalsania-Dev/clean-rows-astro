---
import Layout from "../../layouts/EditorialLayout.astro";
import Hero from "../../components/editorial/Hero.astro";
import FAQ from "../../components/editorial/FAQ.astro";
import Related from "../../components/editorial/Related.astro";
import Contact from "../../components/Contact.astro";
const stateOfSales =
  "https://www.salesforce.com/news/stories/state-of-sales-report-announcement-2026/";
const faqs = [
  [
    "What is a custom B2B lead list?",
    "A custom B2B lead list is a prospect list researched to your own brief. The roles, sectors, company sizes, locations, named accounts and exclusions are agreed first, and the contacts are sourced to match them.",
  ],
  [
    "Is each list sourced fresh?",
    "Yes. Each list is researched when you order, against the brief you approve, and business emails are checked before delivery. It is not pulled from a pre-built database.",
  ],
  [
    "What should a custom list brief include?",
    "Roles and title variations, sectors, company size, locations, any named accounts, exclusions and the fields you need. The more specific the brief, the more consistent the list.",
  ],
  [
    "What if my audience is too small for a package?",
    "We tell you before payment. We don’t widen your criteria to fill a volume; you decide whether to adjust the brief or order fewer leads.",
  ],
  [
    "Can you research fields outside the standard file?",
    "Additional research can be discussed before ordering, with feasibility and price agreed in advance. Tech-stack enrichment is not currently offered.",
  ],
  [
    "When is a custom quote needed?",
    "For orders of 100,000+ leads, specialist research or additional columns, and recurring schedules. Standard audiences within a package use the published prices.",
  ],
  [
    "How is a delivered list accepted?",
    "The agreed brief is the acceptance standard. If rows fall outside it, report them within 7 days of delivery for a free rebuild or a refund.",
  ],
  [
    "Can one order be split into several files?",
    "Yes. Splits by client, territory, desk or campaign, and your preferred column names, are agreed with the brief before research starts.",
  ],
];
---

<Layout
  title="Custom B2B Prospect Lists Built to Your Brief | Clean Rows"
  description="Custom B2B list research: roles, sectors, named accounts, exclusions and required fields scoped before you pay. Narrow audiences stay narrow, never padded."
  label="Custom lists"
  serviceName="Custom B2B prospect list research"
  audience="B2B sales, marketing and agency teams"
  serviceOffers={false}
  faqs={faqs}
  service
>
  <Hero
    label="Custom lists"
    title="Custom B2B lead lists built to your brief"
    accent="Scoped before you pay."
    description="When your audience needs more than a standard package, such as specific titles, named accounts, exclusions or extra research, the brief, feasibility and acceptance criteria are agreed before payment."
    cta="Scope a custom list"
    secondary="What makes a useful brief"
    secondaryHref="#approach"
    panelLabel="WHAT GETS AGREED"
    panelTitle="Agreed before research."
    items={[
      ["Audience", "Roles, sectors, size, location"],
      ["Accounts", "Named targets and exclusions"],
      ["Fields", "Standard or custom columns"],
      ["Acceptance", "The brief, in writing"],
    ]}
  />
  <section class="ed-section" aria-labelledby="cl-compare">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">CUSTOM LIST VS DATABASE EXPORT</p>
          <h2 id="cl-compare">Custom B2B lead lists vs filtered database exports</h2>
        </div>
        <p>
          A custom B2B lead list is researched to your brief at the time you
          order. Salesforce’s{" "}
          <a class="ed-inline" href={stateOfSales} rel="noopener">2026 State of Sales report</a>{" "}
          found the average seller spends 40% of their time selling. When you
          outsource lead list building, the searching, checking and formatting
          stop competing for the rest.
        </p>
      </div>
      <p class="ed-scroll-hint" id="cl-compare-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="Custom lead lists compared with filtered database exports"
        aria-describedby="cl-compare-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap ed-compare">
          <caption>
            A Clean Rows custom list compared with a list your team filters and
            exports from a subscription database. Database features vary by
            provider.
          </caption>
          <thead>
            <tr>
              <th scope="col">Aspect</th>
              <th scope="col">Custom list from Clean Rows</th>
              <th scope="col">Filtered database export</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Starting point</th>
              <td>Your written brief, including edge cases</td>
              <td>The filters the database offers</td>
            </tr>
            <tr>
              <th scope="row">When contacts are sourced</th>
              <td>When you order</td>
              <td>Whenever the database last updated the record</td>
            </tr>
            <tr>
              <th scope="row">Job titles</th>
              <td>Title variations agreed with you before research</td>
              <td>Whatever matches the filter keywords</td>
            </tr>
            <tr>
              <th scope="row">Named accounts and exclusions</th>
              <td>Built into the research</td>
              <td>Applied by your team, before or after export</td>
            </tr>
            <tr>
              <th scope="row">Cleaning and formatting</th>
              <td>We remove duplicates, check business emails and format the file</td>
              <td>Your team cleans the export</td>
            </tr>
            <tr>
              <th scope="row">If rows miss the brief</th>
              <td>Free rebuild or refund if reported within 7 days</td>
              <td>Your team filters and exports again</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="ed-section ed-tint" id="approach" aria-labelledby="cl-brief">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHAT MAKES A USEFUL BRIEF</p>
          <h2 id="cl-brief">Vague in, vague out: how to write a useful ICP brief</h2>
        </div>
        <p>
          Two fictional briefs for the same buyer. The second one tells the
          researcher exactly who counts, who doesn’t and what the file must
          contain.
        </p>
      </div>
      <div class="ed-brief-pair">
        <article class="ed-example-brief ed-brief-weak">
          <span class="ed-kicker">A VAGUE BRIEF</span>
          <p>“Marketing people at tech companies in Europe.”</p>
          <dl>
            <div><dt>Titles</dt><dd>Undefined</dd></div>
            <div><dt>Company size</dt><dd>Undefined</dd></div>
            <div><dt>Exclusions</dt><dd>None</dd></div>
          </dl>
        </article>
        <article class="ed-example-brief">
          <span class="ed-kicker">A USEFUL BRIEF</span>
          <p>
            “VP Marketing and Heads of Demand Generation at B2B software
            companies, 100–1,000 staff, in Germany, the Netherlands and the
            Nordics. Exclude agencies and our current customers. Business email
            and LinkedIn required.”
          </p>
          <dl>
            <div><dt>Titles</dt><dd>Two, with seniority</dd></div>
            <div><dt>Company size</dt><dd>100–1,000 staff</dd></div>
            <div><dt>Exclusions</dt><dd>Agencies, customers</dd></div>
          </dl>
        </article>
      </div>
    </div>
  </section>
  <section class="ed-section" aria-labelledby="cl-parts">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">THE PARTS OF A BRIEF</p>
          <h2 id="cl-parts">The seven parts of a custom B2B lead list brief</h2>
        </div>
        <p>
          You don’t need all seven on day one. Anything left open is settled
          with you before research starts, not guessed.
        </p>
      </div>
      <p class="ed-scroll-hint" id="cl-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="The parts of a custom list brief"
        aria-describedby="cl-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap">
          <caption>
            The parts of a custom list brief, with fictional examples.
          </caption>
          <thead>
            <tr>
              <th scope="col">Part of the brief</th>
              <th scope="col">Example</th>
              <th scope="col">Why it matters</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Roles and title variations</th>
              <td>VP Marketing, Head of Demand Generation</td>
              <td>The same buyer uses different titles at different companies</td>
            </tr>
            <tr>
              <th scope="row">Sectors</th>
              <td>B2B software; not IT services</td>
              <td>Broad labels like “tech” are researched inconsistently</td>
            </tr>
            <tr>
              <th scope="row">Company size</th>
              <td>100–1,000 employees</td>
              <td>Decides whether a dedicated buyer exists at all</td>
            </tr>
            <tr>
              <th scope="row">Location</th>
              <td>Germany, Netherlands, Nordics; company HQ</td>
              <td>HQ and contact location can differ</td>
            </tr>
            <tr>
              <th scope="row">Named accounts</th>
              <td>A list of 250 target companies</td>
              <td>Focuses research on accounts you already prioritize</td>
            </tr>
            <tr>
              <th scope="row">Exclusions</th>
              <td>Current customers, open deals, competitors</td>
              <td>Excluded companies and contacts are part of the acceptance criteria</td>
            </tr>
            <tr>
              <th scope="row">Required fields</th>
              <td>Business email and LinkedIn; phone optional</td>
              <td>Sets what a complete row means for your campaign</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="ed-boundary" aria-labelledby="cl-narrow">
    <div class="ed-wrap">
      <p class="ed-kicker">FEASIBILITY</p>
      <h2 id="cl-narrow">Small audiences stay small: we don’t pad your list</h2>
      <p>
        If fewer people match your brief than the volume you had in mind, we
        tell you before payment. We don’t quietly widen titles, sizes or
        regions to fill a package. You decide whether to adjust the brief or
        order fewer leads.
      </p>
    </div>
  </section>
  <section class="ed-section" aria-labelledby="cl-scope">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">STANDARD OR CUSTOM</p>
        <h2 id="cl-scope">
          Most B2B lead lists fit a standard package. Some need a quote.
        </h2>
        <p>
          Standard packages cover most briefs at{" "}
          <a class="ed-inline" href="/pricing">published prices</a>. A custom
          quote is agreed in writing before any payment.
        </p>
      </div>
      <div class="ed-two-lists">
        <article>
          <h3>Standard package</h3>
          <ul>
            <li>Built to your agreed ICP</li>
            <li>The <a class="ed-inline" href="/whats-in-the-file">standard field groups</a></li>
            <li>CSV or Google Sheet delivery</li>
            <li>1,000 to 50,000 leads</li>
          </ul>
        </article>
        <article>
          <h3>Custom quote</h3>
          <ul>
            <li>100,000+ leads</li>
            <li>Specialist research or extra columns</li>
            <li>Recurring delivery schedules</li>
            <li>Audiences that need feasibility checks</li>
          </ul>
        </article>
      </div>
    </div>
  </section>
  <section class="ed-section ed-tint" aria-labelledby="cl-files">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">FILES AND EXPORTS</p>
          <h2 id="cl-files">
            How your list is delivered: splits, headers and formats
          </h2>
        </div>
        <p>
          File structure is part of the brief, so the list arrives ready to
          split, import and assign.
        </p>
      </div>
      <div class="ed-cards">
        <article>
          <span class="ed-index">01</span>
          <h3>Splits</h3>
          <p>
            One file, or separate files by client, territory, desk or campaign.
          </p>
        </article>
        <article>
          <span class="ed-index">02</span>
          <h3>Headers</h3>
          <p>
            Column names agreed to match the import format of your CRM or
            outreach tool.
          </p>
        </article>
        <article>
          <span class="ed-index">03</span>
          <h3>Format</h3>
          <p>
            A CSV file or a Google Sheet. Delivery times are estimates that
            depend on the audience and volume.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="ed-section" aria-labelledby="cl-agree">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">BEFORE YOU PAY</p>
        <h2 id="cl-agree">
          Scope, timing and acceptance, agreed in writing before you pay
        </h2>
        <p>
          An order is confirmed when criteria, volume and price are agreed in
          writing; email or Slack is enough. See the{" "}
          <a class="ed-inline" href="/refund">Refund Policy</a> for the full
          terms.
        </p>
      </div>
      <ol class="ed-checklist">
        <li>
          <span>01</span>
          <div>
            <h3>Review a sample</h3>
            <p>
              Start with up to 100 free leads, one sample per business, and
              adjust the brief before scaling.
            </p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>Agree scope and timing</h3>
            <p>
              Criteria, volume, fields, splits, price and an estimated delivery
              date are confirmed before payment.
            </p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>The brief is the standard</h3>
            <p>
              Rows outside the agreed criteria, excluded companies, duplicates
              or missing columns are rebuilt or refunded if reported within 7
              days.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <FAQ title="Questions about custom B2B lead lists" items={faqs} />
  <section class="ed-section ed-sources" aria-labelledby="cl-sources">
    <div class="ed-wrap">
      <h2 id="cl-sources" class="ed-kicker">SOURCES</h2>
      <ul>
        <li>
          <a class="ed-inline" href={stateOfSales} rel="noopener">Salesforce, State of Sales report (2026)</a>
          <span>Survey of 4,050 sales professionals, published 3 February 2026: the average seller spends 40% of their time selling. Checked 30 September 2026.</span>
        </li>
      </ul>
    </div>
  </section>
  <Contact
    team="Other"
    heading="Scope your custom list."
    emphasis="Start with 100 leads."
    closing=""
    description="Share the audience, exclusions, required fields and intended volume. We’ll confirm feasibility, timing and price before you pay."
    placeholder="e.g. VP Marketing at B2B software companies, 100–1,000 staff, DACH and Nordics. Exclude agencies. Email and LinkedIn required."
  />
  <Related
    items={[
      [
        "/data-sources",
        "Where the data comes from",
        "Sources, checks and their limits.",
      ],
      [
        "/whats-in-the-file",
        "The standard fields",
        "What every list includes.",
      ],
      ["/pricing", "Standard packages", "Published prices from $25."],
    ]}
  />
</Layout>
