---
import Layout from "../../layouts/EditorialLayout.astro";
import Hero from "../../components/editorial/Hero.astro";
import FAQ from "../../components/editorial/FAQ.astro";
import Related from "../../components/editorial/Related.astro";
import Contact from "../../components/Contact.astro";
import InlineLinks from "../../components/editorial/InlineLinks.astro";

const faqs = [
  [
    "What is a list building service?",
    "A list building service researches a B2B lead list for you against a written brief and delivers the finished file. You set the roles, seniority, industries, company sizes, locations, named accounts and exclusions. We do the research, the email checks and the review, then send a CSV or Google Sheet. No database to search and no subscription to sit on.",
  ],
  [
    "How long does a list take?",
    "Delivery depends on the volume and how tight the brief is. About 3 hours for 1,000 contacts, 24 hours for 10,000 and 48 hours for 50,000. Orders of 100,000 or more take 5 to 7 business days. The exact date is agreed before you pay.",
  ],
  [
    "How is a list building service different from a data platform?",
    "A data platform gives your team a shared database to search, filter and export, usually priced per seat. A list building service hands you the finished file and the work is done when it arrives. You pay once per list, not monthly per person, and nobody on your team has to search.",
  ],
  [
    "What does 10,000 contacts for $199 include?",
    "The 10,000 contact package is one time, $19.90 per 1,000 contacts, delivered in 24 hours. Every row carries the standard fields: name, exact job title, company, domain, verified business email, mobile where public sources show one, company phone, personal and company LinkedIn, company size, industry and location. If the list misses the agreed brief, we rebuild it free or refund you.",
  ],
  [
    "Do I need to buy every month?",
    "No. Each package is a one time price for one list, with no seats and no renewal. Order the next list whenever the next campaign needs it. Recurring delivery is available on request for teams that refresh lists on a schedule.",
  ],
  [
    "What if the list misses my brief?",
    "The brief you agree before payment is the acceptance standard. Rows outside it, excluded companies, duplicates or missing columns get a free rebuild or a refund if you report them within 7 days of delivery.",
  ],
];

const processSteps: [string, string][] = [
  [
    "Send the brief",
    "An email with the roles, seniority, industries, company sizes, locations, named accounts and exclusions is enough. No portal, no onboarding call. sales@cleanrowsdata.com answers it.",
  ],
  [
    "Review a free sample",
    "Up to 100 leads for your ICP arrive within 24 hours, no card and no call. Check the job titles, companies, LinkedIn profiles and emails before anything is paid.",
  ],
  [
    "Count and price, confirmed",
    "We confirm the exact count that matches your ICP and the price for it, in writing, before payment. If fewer people match than you planned, we tell you first. No padded lists.",
  ],
  [
    "Research to the brief",
    "Every row is sourced fresh from public B2B sources: public professional profiles, company websites, public directories and public filings. No personal emails, and no tech stack data.",
  ],
  [
    "Check and clean",
    "Each business email passes two verification tools. Duplicates are removed and a person reviews the list against the brief before it ships.",
  ],
  [
    "Deliver, or rebuild free",
    "The list arrives as a CSV or Google Sheet, with the column names agreed in the brief. If it misses the brief, we rebuild it free or refund you.",
  ],
];

const deliveryRows: [string, string][] = [
  ["1,000 contacts", "About 3 hours"],
  ["10,000 contacts", "24 hours"],
  ["50,000 contacts", "48 hours"],
  ["100,000+ contacts", "5 to 7 business days"],
];

const fieldRows: [string, string, string][] = [
  ["First name and last name", "The name as the person writes it on their professional profile", "Every row"],
  ["Exact job title", "The title they use today, for example VP of Sales or Head of Demand Generation", "Checked against your brief"],
  ["Company", "Company name", "Every row"],
  ["Domain", "The company website domain, useful for CRM matching", "Every row"],
  ["Verified business email", "Work email checked with two verification tools. No personal emails", "Every row"],
  ["Mobile", "Direct mobile where one is found in public sources", "Roughly 50 to 60 percent of rows, marked per row"],
  ["Company HQ phone", "The main company number, a second route when no mobile is found", "Every row"],
  ["Personal LinkedIn URL", "The leader's own profile, for research and LinkedIn outreach", "Where public"],
  ["Company LinkedIn URL", "The company page, for a quick read on headcount and hiring", "Where public"],
  ["Company size", "Employee range, matched to your brief", "Every row"],
  ["Industry", "The company's industry, matched to your brief", "Every row"],
  ["Location", "Location for each row, filtered to your brief", "Every row"],
];

const packageRows: [string, string, string, string, string][] = [
  ["Growth", "10,000", "$199", "$19.90 per 1,000", "24 hours"],
  ["Starter", "1,000", "$25", "$25.00 per 1,000", "About 3 hours"],
  ["Scale", "50,000", "$799", "$15.98 per 1,000", "48 hours"],
  ["Enterprise", "100,000+", "Custom quote", "Quoted for your brief", "5 to 7 business days"],
];
---

<Layout
  title="List Building Service for B2B Teams | Clean Rows"
  description="A B2B list building service that researches fresh lead lists to your ICP. Verified emails and human review. 10,000 contacts for $199, one time."
  label="Custom lists"
  serviceName="Custom B2B prospect list research"
  audience="B2B sales, marketing and agency teams"
  serviceOffers={false}
  faqs={faqs}
  service
>
  <Hero
    label="Custom lists"
    title="B2B list building service. Built to your ICP."
    accent="Scoped before you pay."
    description="A list building service is a done for you replacement for searching a database: we research a fresh prospect list to your brief and deliver the finished file. 10,000 contacts for $199, one time, with no seats and no subscription. [10,000 verified contacts arrive in 24 hours](/buy-b2b-leads), every email checked with two tools and the whole list reviewed by a person. Start with a free sample: no card, no call, no signup."
    cta="Scope your list"
    href="#contact"
    secondary="See the process"
    secondaryHref="#process"
    proof="10,000 contacts for $199. One time. No seats."
    filePanel={{
      fileName: "b2b-list.csv",
      subline: "10,000 contacts · 12 fields",
      rows: [
        { initials: "VS", title: "VP of Sales" },
        { initials: "CE", title: "CEO" },
        { initials: "HR", title: "HR Director" },
      ],
      chips: ["Verified emails", "LinkedIn profiles"],
    }}
    strip={[
      { strong: "Two email checks", sub: "Every address passes two verification tools" },
      { strong: "Free rebuild or refund", sub: "If the list misses the agreed brief" },
      { strong: "CSV in 24 hours", sub: "10,000 contacts, delivered as a CSV or Google Sheet" },
    ]}
  />

  <!-- 1. What it is -->
  <section class="ed-section ed-tint" aria-labelledby="ls-what">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHAT IT IS</p>
          <h2 id="ls-what">A list building service does the searching for you</h2>
        </div>
        <p>
          A list building service takes a written brief and delivers a finished
          B2B lead list: the people who match it, with verified business
          emails, ready for your CRM or outreach tool. You do not search,
          filter or clean anything. You read the file.
        </p>
      </div>
      <div class="ed-split">
        <div>
          <h3 class="ed-subhead">The job, in one paragraph</h3>
          <p>
            Most teams that need a list have three options: search a
            subscription database, build it in house, or hand the work to a
            service. A data platform is software your team works inside every
            day. Building it yourself is real work, one person at a time,
            across LinkedIn, company websites and verification tools. A list
            building service is the third: the work is handed over and a file
            comes back.
          </p>
          <p>
            Clean Rows researches each list when you order, to the roles,
            seniority, industries, company sizes, locations, named accounts
            and exclusions in your brief. We use public B2B sources only,
            check every business email with two verification tools, remove
            duplicates and have a person review the list against your brief.
            If the list misses what you asked for, we rebuild it free or
            refund you.
          </p>
        </div>
        <div>
          <div class="ed-two-lists">
            <article>
              <h3>What you send</h3>
              <ul>
                <li>A brief: roles, seniority, industries, company sizes, locations</li>
                <li>Named accounts or exclusions, where you have them</li>
                <li>The fields and file splits you need</li>
                <li>Where the list will be used</li>
              </ul>
            </article>
            <article>
              <h3>What you get back</h3>
              <ul>
                <li>A CSV or Google Sheet with 12 standard fields</li>
                <li>Business emails checked with two verification tools</li>
                <li>Duplicates removed and a human review of the whole list</li>
                <li>A free rebuild or refund if it misses the brief</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Get a free sample</a>
          <a class="button cta-secondary" href="#process">See the process</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. Writing the brief -->
  <section class="ed-section" aria-labelledby="ls-brief">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHERE THE QUALITY COMES FROM</p>
          <h2 id="ls-brief">Vague in, vague out: writing a brief that works</h2>
        </div>
        <p>
          A list building service is only as sharp as the brief it works
          from. Two briefs for the same buyer, one that works and one that
          does not, show the difference.
        </p>
      </div>
      <div class="ed-flow-pair">
        <article>
          <span class="ed-kicker">A VAGUE BRIEF</span>
          <h3>"Marketing people at tech companies"</h3>
          <ol>
            <li>No titles, so the list mixes juniors with the people who buy</li>
            <li>No company size, so solo founders sit next to 5,000 person firms</li>
            <li>No exclusions, so current customers and competitors end up in the file</li>
            <li>No fields chosen, so you find out what is missing after the send</li>
          </ol>
        </article>
        <article>
          <span class="ed-kicker">A WORKING BRIEF</span>
          <h3>"VP Marketing and Heads of Demand Gen at B2B software companies, 100 to 1,000 staff. Exclude agencies and our current customers. Business email and LinkedIn required"</h3>
          <ol>
            <li>Two titles with seniority, so every row is a real buyer</li>
            <li>A size range, so a dedicated marketing hire actually exists</li>
            <li>Exclusions named, so they are part of the acceptance standard</li>
            <li>Required fields set, so a complete row means something</li>
          </ol>
        </article>
      </div>
      <p>
        The second brief is not longer, just specific. Specificity is where
        a list stops being a pile of contacts and becomes a list of people
        who will actually reply, and it is also what the free sample
        checks. Two briefs that both say "marketing people" can produce
        very different files.
      </p>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Send your brief</a>
          <a class="button cta-secondary" href="#process">See the process</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Process -->
  <section class="ed-section" id="process" aria-labelledby="ls-process">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">SIX STEPS FROM BRIEF TO FILE</p>
          <h2 id="ls-process">How the list building service works</h2>
        </div>
        <p>
          Six steps, none of them inside a portal. The exact count and price
          are confirmed for your ICP before you pay, and the delivery date is
          set with you, not estimated on a ticket.
        </p>
      </div>
      <div class="ed-built">
        <ol class="ed-step-cards">
          {processSteps.map(([title, text], i) => (
            <li>
              <span class="ed-step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="ed-delivery-card" role="region" aria-label="Delivery time by list size" tabindex="0">
          <p class="ed-kicker">DELIVERY TIME</p>
          <table class="ed-table">
            <thead>
              <tr>
                <th scope="col">List size</th>
                <th scope="col">Delivery time</th>
              </tr>
            </thead>
            <tbody>
              {deliveryRows.map(([size, time]) => (
                <tr>
                  <th scope="row">{size}</th>
                  <td>{time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="ed-note">
        A tight brief researches faster. Named accounts, title variations and
        exclusions all take extra care, so the date above moves with the
        brief. It is always confirmed in writing before payment.
      </p>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Start with the free sample</a>
          <a class="button cta-secondary" href="#packages">See packages</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Fields -->
  <section class="ed-section ed-tint" aria-labelledby="ls-fields">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHAT YOU GET</p>
          <h2 id="ls-fields">The 12 fields in every list</h2>
        </div>
        <p>
          The same field groups on every row, so the file imports cleanly
          whatever you load it into. Mobile coverage is the one that varies,
          and it is always marked per row.
        </p>
      </div>
      <p class="ed-scroll-hint" id="ls-fields-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="The 12 fields in every list"
        aria-describedby="ls-fields-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap">
          <caption>
            The standard fields in every Clean Rows list. Additional columns
            can be discussed before ordering. Tech stack enrichment is not
            offered.
          </caption>
          <thead>
            <tr>
              <th scope="col">Field</th>
              <th scope="col">What it contains</th>
              <th scope="col">Coverage</th>
            </tr>
          </thead>
          <tbody>
            {fieldRows.map(([field, what, coverage]) => (
              <tr>
                <th scope="row">{field}</th>
                <td>{what}</td>
                <td>{coverage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Removal requests are honored across future lists, and we never sell
        consumer data or personal emails. The full field guide lives on the
        <a class="ed-inline" href="/whats-in-the-file">what is in the file</a> page.
      </p>
    </div>
  </section>

  <!-- 4. Packages -->
  <section class="ed-section" id="packages" aria-labelledby="ls-packages">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">ONE TIME PACKAGES. NO SEAT FEES.</p>
          <h2 id="ls-packages">Packages led by 10,000 contacts for $199</h2>
        </div>
        <p>
          Each package is a one time price for one list, sized to a typical
          campaign. The count that matches your ICP is confirmed before you
          pay, so you never buy a number you cannot fill.
        </p>
      </div>
      <div class="ed-plan-cards">
        {packageRows.map(([name, leads, price, rate, delivery]) => (
          <article>
            <h3>{name}</h3>
            <strong>{price}</strong>
            <p>{leads} contacts</p>
            <p class="ed-plan-rate">{rate}</p>
            <p class="ed-plan-rate">Delivery {delivery}</p>
          </article>
        ))}
      </div>
      <p class="ed-note">
        [Standard packages and full details live on the pricing page](/pricing).
        Orders of 100,000 or more, specialist research and recurring delivery
        are quoted for your brief, agreed in writing before payment.
      </p>
      <a class="ed-button ed-primary" href="#contact">
        Scope your list
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <!-- 5. Who it is for -->
  <section class="ed-section ed-tint" aria-labelledby="ls-who">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">WHO IT IS FOR</p>
        <h2 id="ls-who">Who a list building service fits</h2>
        <p>
          The service pays for itself when the research is repetitive, the
          list needs to match a specific brief, and nobody on the team wants
          to own a database. Four teams use it the most.
        </p>
      </div>
      <div class="ed-two-lists">
        <article>
          <h3>B2B sales teams</h3>
          <ul>
            <li>A defined ICP per campaign, refreshed when the market shifts</li>
            <li>Outbound runs on clean emails without a database licence per rep</li>
            <li>Target account lists built around a customer base you name yourself</li>
          </ul>
        </article>
        <article>
          <h3>Agencies and consultants</h3>
          <ul>
            <li>One list per client campaign, with per client file splits</li>
            <li>Briefs agreed in writing per engagement, so the file matches the scope</li>
            <li>No per seat fees to pass on to clients between campaigns</li>
          </ul>
        </article>
        <article>
          <h3>Recruitment and hiring teams</h3>
          <ul>
            <li>Hiring manager and employer lists, not candidate data</li>
            <li>Titles and seniority mapped to the roles you are hiring</li>
            <li>LinkedIn profiles for every row, so outreach starts from a real profile</li>
          </ul>
        </article>
        <article>
          <h3>Founders and early stage teams</h3>
          <ul>
            <li>The 1,000 contact package as a first market test, about 3 hours</li>
            <li>A free sample first, so the list is judged before anything is paid</li>
            <li>One list at a time, which suits a budget that grows with the team</li>
          </ul>
        </article>
      </div>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Get a free sample</a>
          <a class="button cta-secondary" href="/for/agencies">For agencies</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5b. Delivery and acceptance -->
  <section class="ed-section ed-tint" aria-labelledby="ls-delivery">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">DELIVERY AND ACCEPTANCE</p>
          <h2 id="ls-delivery">What happens between payment and the file in your inbox</h2>
        </div>
        <p>
          Delivery is not an afterthought on a list building service. It is
          the moment the brief gets checked, and the whole process is
          designed so the file arrives ready to use, not ready to clean.
        </p>
      </div>
      <div class="ed-cards">
        <article>
          <span class="ed-index">01</span>
          <h3>The file arrives formatted</h3>
          <p>
            A CSV or Google Sheet with the column names you agreed. Splits
            by client, territory, desk or campaign come in separate files,
            so an agency can hand one to each client without unmixing them.
            The header row matches what your CRM or outreach tool imports,
            because you said how it imports.
          </p>
        </article>
        <article>
          <span class="ed-index">02</span>
          <h3>The brief is the standard</h3>
          <p>
            Acceptance is judged against the brief you agreed in writing,
            not against a database refresh date. Rows outside the criteria,
            excluded companies, duplicates or missing columns are the
            failure cases, and they trigger a free rebuild or a refund if
            you report them within 7 days of delivery.
          </p>
        </article>
        <article>
          <span class="ed-index">03</span>
          <h3>Public sources, honored removals</h3>
          <p>
            Every row comes from public B2B sources: public professional
            profiles, company websites, public directories and filings. No
            personal emails, no consumer data. If someone asks to be
            removed, they are removed from future lists. The sourcing detail
            is on the <a class="ed-inline" href="/data-sources">data sources</a> page.
          </p>
        </article>
      </div>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Get a free sample</a>
          <a class="button cta-secondary" href="/refund">Read the refund policy</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Comparison -->
  <section class="ed-section" aria-labelledby="ls-vs">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">THREE WAYS TO GET THE LIST</p>
          <h2 id="ls-vs">List building service vs doing it yourself vs a data platform</h2>
        </div>
        <p>
          The same three ways to reach the right people, compared on the
          questions that decide. No platform names: the comparison is about
          the model, and each provider's details vary.
        </p>
      </div>
      <p class="ed-scroll-hint" id="ls-vs-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="List building service compared with doing it yourself and a data platform"
        aria-describedby="ls-vs-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap ed-compare">
          <caption>
            A list building service compared with building the list yourself
            and with a data platform. Platform features and prices vary by
            provider.
          </caption>
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col">List building service</th>
              <th scope="col">Doing it yourself</th>
              <th scope="col">Data platform</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">What you get</th>
              <td>A finished file, researched to your brief</td>
              <td>The file your team puts together, one contact at a time</td>
              <td>Access to a shared database and the tools around it</td>
            </tr>
            <tr>
              <th scope="row">Who does the research</th>
              <td>The service, to your written brief</td>
              <td>Your team, in whoever's free hours</td>
              <td>Your team, inside the platform</td>
            </tr>
            <tr>
              <th scope="row">How you pay</th>
              <td>Once per list: $25 for 1,000, $199 for 10,000, $799 for 50,000</td>
              <td>Time, plus verification tools and search credits</td>
              <td>Usually per seat, monthly or annually</td>
            </tr>
            <tr>
              <th scope="row">Freshness of each row</th>
              <td>Researched for your order</td>
              <td>As fresh as when you looked it up</td>
              <td>Depends on the platform's update cycle</td>
            </tr>
            <tr>
              <th scope="row">Emails verified</th>
              <td>Two verification tools, on every address, before delivery</td>
              <td>Whichever checker your team uses, on the rows it gets to</td>
              <td>Depends on the plan and its credits</td>
            </tr>
            <tr>
              <th scope="row">Time to a usable list of 10,000</th>
              <td>24 hours, confirmed before you pay</td>
              <td>Days to weeks, depending on how many people are doing it</td>
              <td>Depends on filtering, exporting and cleaning inside the tool</td>
            </tr>
            <tr>
              <th scope="row">Commitment</th>
              <td>None: one list at a time, no seats, no renewal</td>
              <td>Ongoing, as long as the team keeps doing it</td>
              <td>A subscription, usually annual</td>
            </tr>
            <tr>
              <th scope="row">What happens when it misses the brief</th>
              <td>Free rebuild or refund, reported within 7 days</td>
              <td>Your team finds and fixes the rows</td>
              <td>Depends on the provider's data policy</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        A platform can be the right call when your reps prospect every day.
        It is the wrong call when the job is one clean list for one
        campaign, or when nobody on the team wants to own the searching.
        The <a class="ed-inline" href="/compare/b2b-data-subscriptions">per list vs per seat comparison</a>{" "}
        works the two models out in detail.
      </p>
      <div class="section-cta">
        <div class="cta-pair">
          <a class="button cta-primary" data-sample href="#contact">Scope your list</a>
          <a class="button cta-secondary" href="/calculator">Cost it against a subscription</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. What to check -->
  <section class="ed-section ed-tint" aria-labelledby="ls-check">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">BEFORE YOU CHOOSE ANY PROVIDER</p>
          <h2 id="ls-check">Six questions to ask a list building service</h2>
        </div>
