---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import FAQ from '../../components/FAQ.astro';
import How from '../../components/How.astro';
import Pricing from '../../components/Pricing.astro';
import Results from '../../components/Results.astro';
import Compliance from '../../components/Compliance.astro';
import WhoNotFor from '../../components/WhoNotFor.astro';
import Founder from '../../components/Founder.astro';
import SampleTable from '../../components/SampleTable.astro';
---
<BaseLayout title="Targeted B2B Email Lists & ICP Building" description="Custom B2B data lists built for your ICP.">


  <section class="hero" id="top">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker">CUSTOM RESEARCH</p>
        <h1>Targeted B2B Email Lists</h1>
        <p class="hero-description">Stop relying on stale databases. We build bespoke outbound lists mapped exactly to your Ideal Customer Profile.</p>
        <div class="hero-actions">
          <div class="cta-pair">
            <a class="button lime cta-primary" href="#contact">Get 100 free leads</a>
          </div>
        </div>
      </div>
    </div>
  </section>
<How />
<Results />
<SampleTable />
<Compliance />
<WhoNotFor />
<Founder />
<Pricing />
<FAQ />
<Contact />
</BaseLayout>
