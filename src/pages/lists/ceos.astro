---
import Layout from "../../layouts/EditorialLayout.astro";
import Hero from "../../components/editorial/Hero.astro";
import FAQ from "../../components/editorial/FAQ.astro";
import Related from "../../components/editorial/Related.astro";
import PlanStrip from "../../components/editorial/PlanStrip.astro";
import Contact from "../../components/Contact.astro";
const faqs = [
  [
    "What is a CEO email list?",
    "A CEO email list is a B2B prospect list of company leaders, such as CEOs, founders and managing directors, with business emails, LinkedIn profiles and company details. Clean Rows researches each one fresh to your title rules and company criteria.",
  ],
  [
    "Which titles are included in a CEO list?",
    "The titles are agreed with your brief. Common choices are CEO, Founder, Co-founder and Managing Director; Owner or President can fit depending on company size and country.",
  ],
  [
    "Can former, fractional or consultant CEOs be left out?",
    "Yes, when the brief says so. Former CEOs, fractional or interim executives, advisors and consultants using a CEO title can be excluded; check the sample to confirm the rule held.",
  ],
  [
    "Can I get more than one leader per company?",
    "Yes. Agree a maximum per account, for example the CEO plus up to two co-founders. The default for your order is set in the brief, not assumed.",
  ],
  [
    "Does a CEO title mean the person has budget?",
    "No. A leadership title describes a role, not budget or buying intent. At larger companies a department head may own the decision you care about.",
  ],
  [
    "What contact details come with each CEO?",
    "Each row includes the business email, a personal LinkedIn profile and company context such as size, industry and location. Phone numbers are included where available.",
  ],
  [
    "How much does a CEO email list cost?",
    "Standard packages are $25 for 1,000 leads, $199 for 10,000 and $799 for 50,000, in USD. Narrow audiences or extra research may need a custom quote before payment.",
  ],
];
---

<Layout
  title="CEO & Founder Email Lists Built to Your ICP | Clean Rows"
  description="CEO and founder email lists with business emails, LinkedIn profiles and company context. Title rules and exclusions agreed first. 100 free leads to start."
  label="CEO lists"
  serviceName="CEO and founder prospect lists"
  audience="B2B teams selling to company leaders"
  planHref="#pricing"
  faqs={faqs}
  service
>
  <Hero
    label="CEO & founder lists"
    title="CEO and founder contact lists for B2B outreach"
    accent="Titles agreed first."
    description="Reach the people who run the companies you sell to. Agree which leadership titles count, which companies qualify and who to leave out, before any research starts."
    cta="Brief a CEO sample"
    secondary="See the title rules"
    secondaryHref="#approach"
    panelLabel="EXAMPLE CEO BRIEF"
    panelTitle="Founder-led services firms."
    items={[
      ["Titles", "CEO, Founder, Managing Director"],
      ["Companies", "Agencies, 10–50 staff"],
      ["Location", "United States, Canada"],
      ["Exclude", "Former, fractional, advisors"],
    ]}
  />
  <section class="ed-section ed-tint" id="approach" aria-labelledby="ceo-titles">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHO COUNTS AS A CEO</p>
          <h2 id="ceo-titles">
            Which job titles count in a CEO and founder list
          </h2>
        </div>
        <p>
          The person running a company might call themselves CEO, Founder or
          Managing Director. Others use a CEO title for work that isn’t running
          your target company at all. Agree the rules first.
        </p>
      </div>
      <p class="ed-scroll-hint" id="ceo-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="CEO and founder title rules"
        aria-describedby="ceo-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap">
          <caption>
            Common title rules. Your final list of included and excluded
            titles is agreed with the brief.
          </caption>
          <thead>
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Usually means</th>
              <th scope="col">Decide in the brief</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">CEO</th>
              <td>The most senior executive running the company</td>
              <td>Include by name only, or with founders too?</td>
            </tr>
            <tr>
              <th scope="row">Founder, Co-founder</th>
              <td>Started the business; may or may not still run it</td>
              <td>Only founders still in an operating role?</td>
            </tr>
            <tr>
              <th scope="row">Managing Director</th>
              <td>Runs the company in the UK and many other markets; can mean a regional head elsewhere</td>
              <td>Company-wide MDs only, or country MDs as well?</td>
            </tr>
            <tr>
              <th scope="row">Owner, President</th>
              <td>Common at small or family-owned businesses and in the US</td>
              <td>Which company sizes this should apply to</td>
            </tr>
            <tr>
              <th scope="row">Former, fractional, interim, advisor</th>
              <td>Not currently running the target company</td>
              <td>Usually excluded; confirm in the brief</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="ed-section" aria-labelledby="ceo-accounts">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">ONE LEADER OR SEVERAL</p>
          <h2 id="ceo-accounts">
            How many CEOs and founders to include per company
          </h2>
        </div>
        <p>
          Many startups have two or three co-founders. Choose whether you want
          the single most senior leader or every founder at each account.
        </p>
      </div>
      <div class="ed-brief-pair">
        <article class="ed-example-brief">
          <span class="ed-kicker">OPTION A · ONE PER ACCOUNT</span>
          <p>
            The most senior leader at each company. Simpler to sequence, and
            every row is a different business.
          </p>
          <dl>
            <div><dt>Rows per company</dt><dd>1</dd></div>
            <div><dt>Useful when</dt><dd>You want account coverage</dd></div>
          </dl>
        </article>
        <article class="ed-example-brief">
          <span class="ed-kicker">OPTION B · UP TO AN AGREED LIMIT</span>
          <p>
            The CEO plus co-founders or other agreed leaders. Multiple routes
            into the same company, with fewer companies per 1,000 rows.
          </p>
          <dl>
            <div><dt>Rows per company</dt><dd>Agreed maximum</dd></div>
            <div><dt>Useful when</dt><dd>Founders share decisions</dd></div>
          </dl>
        </article>
      </div>
    </div>
  </section>
  <section class="ed-section ed-tint" aria-labelledby="ceo-companies">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">THE COMPANY COMES FIRST</p>
        <h2 id="ceo-companies">
          The right CEO at the right company: size, sector and location
        </h2>
        <p>
          A CEO list is only as useful as the companies behind it. Every row
          carries the{" "}
          <a class="ed-inline" href="/whats-in-the-file">company context</a>{" "}
          your team needs to judge fit.
        </p>
      </div>
      <ol class="ed-checklist">
        <li>
          <span>01</span>
          <div>
            <h3>Company size</h3>
            <p>
              At a 15-person company the CEO often makes the purchase. At 5,000
              people they rarely evaluate tools. Set the size range to match
              who actually buys.
            </p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>Sector</h3>
            <p>
              Name the industries you serve and any you don’t. “Tech
              companies” is too broad to research consistently.
            </p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>Geography</h3>
            <p>
              Countries, regions or states. Agree whether location means the
              company’s headquarters or where the leader is based.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="ed-boundary" aria-labelledby="ceo-boundary">
    <div class="ed-wrap">
      <p class="ed-kicker">A TITLE IS NOT A BUDGET</p>
      <h2 id="ceo-boundary">A CEO title doesn’t prove buying intent</h2>
      <p>
        A CEO list tells you who runs a company, not whether they have budget,
        a current need or any interest in your offer. Treat each row as a
        starting point for research, and check your intended outreach against
        our <a href="/data-sources">sourcing approach</a>.
      </p>
    </div>
  </section>
  <PlanStrip
    kicker="CEO LIST PRICING"
    heading="CEO email list pricing: same price per lead, any title"
    points={[
      [
        "Priced by volume",
        "CEO and founder lists use the same standard packages as every other audience.",
      ],
      [
        "Title rules included",
        "Agreeing included and excluded titles is part of the brief, not an extra.",
      ],
      [
        "Narrow audiences quoted first",
        "If your company criteria leave too few CEOs to fill a package, we tell you before payment.",
      ],
    ]}
    note="Prices in USD. One-time packages, no seat fees. Targeting, coverage and delivery date are confirmed before payment."
  />
  <FAQ title="Questions about CEO and founder email lists" items={faqs} />
  <Contact
    team="Other"
    heading="Brief your CEO list."
    emphasis="Start with 100 leads."
    closing=""
    description="Share the titles, company profile and locations you want, plus anyone to leave out. We’ll confirm coverage and timing before you pay."
    placeholder="e.g. CEOs and founders at US and Canadian agencies, 10–50 staff. Exclude fractional and former CEOs."
  />
  <Related
    items={[
      [
        "/lists/vp-sales",
        "Selling to sales leaders?",
        "VP of Sales and CRO lists.",
      ],
      [
        "/whats-in-the-file",
        "See every field",
        "The standard file with a CSV preview.",
      ],
      [
        "/services/custom-lists",
        "A very narrow audience?",
        "Scope custom research first.",
      ],
    ]}
  />
</Layout>
