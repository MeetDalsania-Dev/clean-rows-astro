---
import Layout from "../layouts/EditorialLayout.astro";
import Hero from "../components/editorial/Hero.astro";
import FAQ from "../components/editorial/FAQ.astro";
import Related from "../components/editorial/Related.astro";
import Pricing from "../components/Pricing.astro";
import Contact from "../components/Contact.astro";
const faqs = [
  [
    "How much do Clean Rows prospect lists cost?",
    "Standard packages are $25 for 1,000 leads, $199 for 10,000 and $799 for 50,000, in USD. Orders of 100,000+ leads and specialist research receive a custom quote.",
  ],
  [
    "Can I buy a B2B email list without a subscription?",
    "Yes. Standard packages are one time purchases with no seat fees or automatic renewal. Recurring delivery is agreed separately if you need it.",
  ],
  [
    "What is included in the price?",
    "Standard targeting and prospect field groups are included. Phone numbers are provided where available; extra research and custom requirements are confirmed before payment.",
  ],
  [
    "Do I pay before seeing a sample?",
    "You can request 100 free leads before your first paid order, using a work email address. Review the sample and agree the full scope, price and timing before proceeding.",
  ],
  [
    "How do I pay for a list?",
    "Payment is arranged after the scope is agreed. Available methods are bank transfer, PayPal, Wise and Remitly. Selecting a package on this page does not charge you.",
  ],
  [
    "How long will my list take?",
    "We confirm the delivery date before payment. Delivery is about 3 hours for 1,000 leads, 24 hours for 10,000 and 48 hours for 50,000; orders of 100,000+ take 5 to 7 business days.",
  ],
  [
    "What if the delivered list does not match the brief?",
    "Report mismatches within 7 days of delivery with examples of affected rows. You can choose a rebuild or refund under the refund policy; campaign results are not covered.",
  ],
  [
    "Do I get an invoice?",
    "Yes. Every paid order comes with an invoice for the amount you pay, so you can keep it for your records or share it with your finance team.",
  ],
  [
    "What if my ICP has fewer contacts than a package?",
    "We confirm the count for your ICP before payment. If fewer people match than the volume you had in mind, we tell you the real number first and you decide whether to adjust the brief or order fewer leads.",
  ],
  [
    "Can I split one package across clients?",
    "Yes. Splits by client, territory or campaign are agreed in the brief before research starts, and each file can carry the column names your import needs.",
  ],
  [
    "Can I get recurring monthly delivery?",
    "Yes, on request. Recurring delivery is agreed separately from a one time package: you set the schedule, volume and price in advance, and we confirm coverage before each delivery. Standard packages have no automatic renewal.",
  ],
];
const orderSteps: [string, string][] = [
  [
    "Send the brief",
    "Roles, seniority, industries, company sizes and locations, plus named accounts and exclusions. No portal and no onboarding call.",
  ],
  [
    "Count and price confirmed",
    "We confirm the exact count for your ICP and the price for it, in writing, before you pay. No padded numbers.",
  ],
  [
    "Research and checks",
    "Every row is sourced from public B2B sources, each email passes two verification tools, duplicates are removed and a person reviews the list.",
  ],
  [
    "Delivery",
    "You receive a CSV or Google Sheet in the agreed format and time, with mobile marked on the rows where one was found.",
  ],
  [
    "Rebuild or refund",
    "If the list misses the agreed brief, report it within 7 days for a free rebuild or a refund.",
  ],
];
const deliveryRows: [string, string][] = [
  ["1,000 leads", "About 3 hours"],
  ["10,000 leads", "24 hours"],
  ["50,000 leads", "48 hours"],
  ["100,000+ leads", "5 to 7 business days"],
];
---

<Layout
  title="B2B Lead List Pricing: 10,000 Contacts for $199 | Clean Rows"
  description="10,000 B2B leads for $199, one time, no seats or subscription. Four packages, a free sample in 24 hours plus verified business emails in every list."
  label="Pricing"
  faqs={faqs}
  service
>
  <Hero
    label="Pricing"
    title="B2B lead list pricing"
    accent="One clear price."
    description="One time B2B prospect list packages. Choose the volume your campaign needs, agree the brief and get a file your team can share."
    cta="Get a free sample"
    samplePrimary
    secondary="Choose a package"
    secondaryHref="#pricing"
    proof="10,000 contacts for $199, one time, no seats."
    answer={[
      {
        label: "What you pay",
        text: "10,000 contacts for $199, one time, no seats.",
      },
      {
        label: "What you get",
        text: "A researched B2B list with verified business emails and company details.",
      },
      {
        label: "How fast",
        text: "Delivered in 24 hours, with a free sample within a day.",
      },
    ]}
    panelLabel="THE GROWTH PACKAGE"
    panelTitle="10,000 leads. $199."
    items={[
      ["Prospects", "10,000 verified leads"],
      ["Per 1,000", "$19.90"],
      ["Seat fees", "$0"],
      ["Subscription", "None"],
    ]}
  />
  <Pricing
    heading="Buy verified B2B email lists by volume, not by seat"
    description="The same standard field groups across every package. Your targeting, coverage and delivery date are confirmed before payment; narrow audiences and specialist research may need a custom quote."
  />
  <div class="ed-wrap">
    <p class="ed-note"><a class="ed-inline" href="/calculator">Estimate your list size with our calculator</a> before you pick a package.</p>
  </div>

  <!-- What happens after you order -->
  <section class="ed-section ed-tint" aria-labelledby="after-order">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHAT HAPPENS AFTER YOU ORDER</p>
          <h2 id="after-order">From brief to a delivered, checked list</h2>
        </div>
        <p>
          Choosing a package opens a request, it does not charge you or start a
          subscription. These are the five steps, in order, with the delivery
          time each list size takes.
        </p>
      </div>
      <div class="ed-built">
        <ol class="ed-step-cards">
          {orderSteps.map(([title, text], i) => (
            <li>
              <span class="ed-step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="ed-delivery-card" role="region" aria-label="Delivery time by list size" tabindex="0">
          <p class="ed-kicker">DELIVERY TIME</p>
          <table class="ed-table">
            <thead>
              <tr>
                <th scope="col">List size</th>
                <th scope="col">Delivery time</th>
              </tr>
            </thead>
            <tbody>
              {deliveryRows.map(([size, time]) => (
                <tr>
                  <th scope="row">{size}</th>
                  <td>{time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Risk reversal -->
  <section class="ed-section" aria-labelledby="risk-reversal">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">THE RISK IS ON US</p>
        <h2 id="risk-reversal">You can check the fit before anything is paid</h2>
        <p>
          The order is built so you only commit after you have seen the work
          and the numbers. If it is not right, the cost stays with us, not
          with you.
        </p>
      </div>
      <div class="ed-two-lists">
        <article>
          <h3>Before you pay</h3>
          <ul>
            <li>A free sample of 100 leads, no card and no call</li>
            <li>The count for your ICP confirmed before payment</li>
            <li>No subscription and no automatic renewal</li>
          </ul>
        </article>
        <article>
          <h3>After delivery</h3>
          <ul>
            <li>Free rebuild or refund if the list misses the brief</li>
            <li>Report within 7 days with the affected rows</li>
            <li>An invoice for the amount you pay</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="ed-section ed-tint" id="approach">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">WHAT YOU ARE BUYING</p>
        <h2>What’s included in every B2B prospect list order</h2>
        <p>
          See the{" "}
          <a class="ed-inline" href="/whats-in-the-file">
            full field specification
          </a>{" "}
          and{" "}
          <a class="ed-inline" href="/data-sources">
            sourcing approach
          </a>{" "}
          before comparing packages.
        </p>
      </div>
      <div class="ed-two-lists">
        <article>
          <h3>Included as standard</h3>
          <ul>
            <li>Research done fresh for your order</li>
            <li>Targeting against your agreed ICP</li>
            <li>Prospect and company field groups</li>
            <li>Business email contact checks</li>
            <li>Deduplication and file formatting</li>
            <li>CSV or Google Sheet delivery</li>
          </ul>
        </article>
        <article>
          <h3>Confirm before ordering</h3>
          <ul>
            <li>Coverage for narrow or specialist audiences</li>
            <li>Phone availability for your market</li>
            <li>Additional research and custom columns</li>
            <li>Per client splits and recurring schedules</li>
            <li>Delivery timing and acceptance criteria</li>
          </ul>
        </article>
      </div>
    </div>
  </section>
  <section class="ed-section" aria-labelledby="pricing-compare">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">PER LIST VS PER SEAT</p>
          <h2 id="pricing-compare">Per list pricing vs a data subscription priced per seat</h2>
        </div>
        <p>
          Clean Rows prices each B2B lead list once, by volume. There are no
          seat fees, no credits and no renewal. Subscription terms vary by
          provider, so compare against your actual quotes or read the{" "}
          <a class="ed-inline" href="/compare/b2b-data-subscriptions">full comparison</a>.
        </p>
      </div>
      <p class="ed-scroll-hint" id="pricing-compare-hint">
        Scroll sideways to see every column.
      </p>
      <div
        class="ed-table-scroll ed-table-light"
        role="region"
        aria-label="Per list pricing compared with a per seat subscription"
        aria-describedby="pricing-compare-hint"
        tabindex="0"
      >
        <table class="ed-table ed-table-wrap ed-compare">
          <caption>
            Clean Rows per list pricing compared with a typical per seat data
            subscription. Subscription terms vary by provider.
          </caption>
          <thead>
            <tr>
              <th scope="col">Aspect</th>
              <th scope="col">Clean Rows</th>
              <th scope="col">Typical subscription</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">What you pay for</th>
              <td>One researched list, priced by volume</td>
              <td>Access to a shared database, priced per user</td>
            </tr>
            <tr>
              <th scope="row">Seat fees</th>
              <td>None</td>
              <td>Usually charged for each seat</td>
            </tr>
            <tr>
              <th scope="row">Commitment</th>
              <td>None; buy one package at a time</td>
              <td>A monthly or annual subscription</td>
            </tr>
            <tr>
              <th scope="row">Credits</th>
              <td>Not used; the price covers the agreed list</td>
              <td>Often limit exports or reveals per seat</td>
            </tr>
            <tr>
              <th scope="row">Quiet months</th>
              <td>No order, no charge</td>
              <td>The subscription still bills</td>
            </tr>
            <tr>
              <th scope="row">Who builds the list</th>
              <td>We research it fresh to your brief</td>
              <td>Your team searches and exports</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <FAQ title="Questions about pricing and buying a B2B lead list" items={faqs} />
  <Contact
    heading="Choose a package."
    emphasis="Check the fit first."
    closing=""
    description="Send your audience and intended volume. We’ll confirm coverage, timing and any custom scope before you pay. You can start with 100 free leads."
  />
  <Related
    items={[
      [
        "/compare/b2b-data-subscriptions",
        "Lists vs data subscriptions",
        "Per list or per seat?",
      ],
      [
        "/services/custom-lists",
        "Need a custom scope?",
        "Discuss specialist research.",
      ],
      [
        "/free-sample",
        "Start with a sample",
        "Review the audience before buying.",
      ],
    ]}
  />
</Layout>
