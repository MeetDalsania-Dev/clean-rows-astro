---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/editorial/Hero.astro";
const faqs = [
  [
    "Can I get a UK B2B list by city or postcode, or only nationally?",
    "Yes, both. Brief by nation, city or postcode area, or brief nationally by SIC code and title. The free 100-lead sample shows whether your geography and industry combination returns the fit you want before you pay.",
  ],
  [
    "What is a SIC code, and do I need one to order?",
    "A SIC code is the five-digit UK classification for what a business does, reported to Companies House. You do not need to know yours: describe your target industry in plain words and Clean Rows maps it to SIC sections in the brief. If you already target by SIC, give the codes and they will be used as the filter.",
  ],
  [
    "Do UK lists include postcodes?",
    "Yes, location fields in the file cover nation and city and, where the brief asks for it, postcode-area targeting. Postcode briefs are written as an area brief, not as a promise that every record carries a verified full postcode.",
  ],
  [
    "Is cold email to UK businesses legal under UK GDPR and PECR?",
    "It depends on who you email. PECR treats limited companies and LLPs as corporate subscribers, while sole traders and most partnerships are treated as individual subscribers who need consent or a valid soft opt-in. Even for corporate addresses, a named person's work email is personal data under UK GDPR, so you need a lawful basis and you must offer an opt-out in every message. This is general information, not legal advice, and your sending setup and message matter as much as the list.",
  ],
  [
    "How is a UK list different from a subscription database?",
    "A subscription charges per seat per month for access to a database you search yourself, with credits for reveals. Clean Rows charges per finished list: you describe your ideal UK customer, check a free 100-lead sample, and pay only for the human-reviewed file. Subscriptions suit daily prospectors; pay-per-list suits campaigns, agencies and founders who want the list done for them.",
  ],
];
const origin = Astro.site || new URL("https://www.cleanrowsdata.com");
const url = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", origin).href;
const schema = [
  {
    "@type": "Service",
    "@id": new URL("/#uk-service", origin).href,
    name: "UK B2B data lists",
    description:
      "Verified UK B2B prospect lists built by nation, city, postcode area, SIC industry code, company size and job title, with name, title, company, verified business email and LinkedIn URL.",
    url,
    serviceType: "Custom B2B prospect list research",
    areaServed: "GB",
    provider: { "@id": new URL("/#organization", origin).href },
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map(([name, text]) => ({
      "@type": "Question",
      name,
      acceptedAnswer: { "@type": "Answer", text },
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
      { "@type": "ListItem", position: 2, name: "B2B Data", item: new URL("/b2b-data", origin).href },
      { "@type": "ListItem", position: 3, name: "UK", item: url },
    ],
  },
  {
    "@type": "ItemList",
    name: "Related Clean Rows pages",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Pricing", url: new URL("/pricing", origin).href },
      { "@type": "ListItem", position: 2, name: "Free sample", url: new URL("/free-sample", origin).href },
      { "@type": "ListItem", position: 3, name: "Calculator", url: new URL("/calculator", origin).href },
      { "@type": "ListItem", position: 4, name: "B2B data subscriptions", url: new URL("/compare/b2b-data-subscriptions", origin).href },
    ],
  },
];
---
<BaseLayout
  title="UK B2B Data Lists | Verified Business Emails by SIC, Postcode and City | Clean Rows"
  description="Build a verified UK B2B prospect list by SIC code, postcode, city or nation. Human-reviewed lists from $25 per 1,000 leads, with a free 100-lead sample before you pay."
  schema={schema}
  editorial
>
  <Hero
    label="UK B2B data"
    title="UK B2B data lists, built to your brief"
    accent="Nations, cities, postcodes and SIC sectors."
    description="Clean Rows builds verified UK B2B prospect lists by nation, city, postcode area, industry (SIC code), company size and job title. Every list is built fresh to your brief, human-reviewed, and delivered with name, title, company, verified business email and LinkedIn URL. Pricing starts at $25 for 1,000 leads, and you get 100 free sample leads built to your brief before you pay anything."
    cta="Get 100 free UK leads"
    href="/free-sample#contact"
    secondary="See the filters"
    secondaryHref="#uk-filters"
    note="Pay-per-list · No seat fees · Freshly sourced"
    panelLabel="EXAMPLE UK BRIEF"
    panelTitle="Professional services, North West."
    items={[
      ["Nation", "England"],
      ["City", "Manchester"],
      ["SIC section", "M (professional services)"],
      ["Titles", "Heads of Operations, Finance Director"],
    ]}
  />

  <section class="ed-section" aria-labelledby="uk-filters">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">BRIEFING A UK LIST</p>
          <h2 id="uk-filters">What you can filter a UK list by</h2>
        </div>
        <p>
          Each row below is a way to narrow the brief. The example is a
          realistic starting point; coverage is confirmed against your sample
          before you pay.
        </p>
      </div>
      <div class="ed-table-scroll ed-table-light" role="region" aria-label="Filters for a UK list" tabindex="0">
        <table class="ed-table ed-table-wrap">
          <caption>Filters you can use when briefing a UK B2B list.</caption>
          <thead>
            <tr>
              <th scope="col">Filter</th>
              <th scope="col">How to use it</th>
              <th scope="col">Example brief</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Nation and city</th>
              <td>Target where your buyers actually operate, not just where HQ sits</td>
              <td>SaaS buyers in London and Manchester, or firms across Scotland</td>
            </tr>
            <tr>
              <th scope="row">Postcode area</th>
              <td>Tight local or regional campaigns, trade-show and territory lists</td>
              <td>Companies in a named postcode area or a city-centre brief</td>
            </tr>
            <tr>
              <th scope="row">SIC code</th>
              <td>Industry targeting using the UK standard classification</td>
              <td>SIC section J (information and communication) or section M (professional, scientific and technical activities)</td>
            </tr>
            <tr>
              <th scope="row">Company size</th>
              <td>Headcount or revenue band, so small teams do not pay for enterprise-only lists</td>
              <td>11-50 employee professional services firms</td>
            </tr>
            <tr>
              <th scope="row">Job title and seniority</th>
              <td>Decision makers by role, not just company domain</td>
              <td>Heads of Operations, Finance Directors, practice owners</td>
            </tr>
            <tr>
              <th scope="row">Company type</th>
              <td>Limited companies, LLPs and other entity types, kept separate in the brief</td>
              <td>Limited companies only, so sole-trader rules do not get mixed into the same send</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="ed-note">
        The postcode-area and company-type rows describe brief options, not a
        guarantee that every signal exists for every industry. Confirm
        availability when the brief is written; do not promise a signal the
        sample cannot show. Entity type also matters in the UK for a legal
        reason. See the <a class="ed-inline" href="#uk-compliance">compliance</a> section.
      </p>
    </div>
  </section>

  <section class="ed-section ed-tint" aria-labelledby="uk-sic">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">INDUSTRY TARGETING</p>
          <h2 id="uk-sic">UK industry codes: SIC, explained for buyers</h2>
        </div>
        <p>
          SIC stands for Standard Industrial Classification. In the UK it is the
          system used to classify what a business does, and it is the code a
          company reports to Companies House when it registers and on its
          confirmation statement.
        </p>
      </div>
      <div class="ed-field-grid ed-subsectors">
        <article class="ed-field-card">
          <div class="ed-field-top"><span class="ed-index">01</span><h3>How a SIC code works</h3></div>
          <ul>
            <li>A UK SIC code is five digits long.</li>
            <li>A company selects between one and four SIC codes, covering its main activities.</li>
            <li>Companies House uses a condensed list drawn from the full ONS classification.</li>
            <li>The code describes the activity, not the company registration number. The registration number identifies the company; the SIC code describes what it does.</li>
          </ul>
        </article>
        <article class="ed-field-card">
          <div class="ed-field-top"><span class="ed-index">02</span><h3>Useful SIC 2007 sections for prospecting</h3></div>
          <p>Section letters and names, checked 2026-10-24 against the ONS section list.</p>
          <dl>
            <div><dt>A</dt><dd>Agriculture, forestry and fishing</dd></div>
            <div><dt>B</dt><dd>Mining and quarrying</dd></div>
            <div><dt>C</dt><dd>Manufacturing</dd></div>
            <div><dt>D</dt><dd>Electricity, gas, steam and air conditioning supply</dd></div>
            <div><dt>E</dt><dd>Water supply; sewerage, waste management and remediation activities</dd></div>
            <div><dt>F</dt><dd>Construction</dd></div>
            <div><dt>G</dt><dd>Wholesale and retail trade; repair of motor vehicles and motorcycles</dd></div>
            <div><dt>H</dt><dd>Transportation and storage</dd></div>
            <div><dt>I</dt><dd>Accommodation and food service activities</dd></div>
            <div><dt>J</dt><dd>Information and communication</dd></div>
            <div><dt>K</dt><dd>Financial and insurance activities</dd></div>
            <div><dt>L</dt><dd>Real estate activities</dd></div>
            <div><dt>M</dt><dd>Professional, scientific and technical activities</dd></div>
            <div><dt>N</dt><dd>Administrative and support service activities</dd></div>
            <div><dt>P</dt><dd>Education</dd></div>
            <div><dt>Q</dt><dd>Human health and social work activities</dd></div>
            <div><dt>R</dt><dd>Arts, entertainment and recreation</dd></div>
            <div><dt>S</dt><dd>Other service activities</dd></div>
          </dl>
        </article>
      </div>
      <p class="ed-note">
        A SIC code is the activity a company reports, not a guarantee that every
        company in a section buys the same way. Different companies in one
        section can be very different buyers. Clean Rows therefore treats SIC
        as a targeting filter in the brief, not as a certified buyer label on
        each company. The free sample lets the buyer check fit before paying.
      </p>
    </div>
  </section>

  <section class="ed-section" aria-labelledby="uk-coverage">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">UK COVERAGE</p>
        <h2 id="uk-coverage">Nations, cities and postcodes</h2>
        <p>
          The UK is England, Scotland, Wales and Northern Ireland. Clean Rows
          builds lists across the UK, and there is no nation we refuse to build
          for. No minimum UK coverage claim is made on this page, because
          coverage depends on the industry and title in the brief. A narrow
          brief will always return fewer rows than a broad one, and the free
          100-lead sample is how the buyer sees real coverage before
          committing.
        </p>
      </div>
      <div class="ed-two-lists">
        <article>
          <h3>Regional briefs that work well</h3>
          <ul>
            <li>National UK lists by industry and title</li>
            <li>Nation lists (England, Scotland, Wales or Northern Ireland)</li>
            <li>City lists, for example London, Manchester, Birmingham, Leeds, Edinburgh, Glasgow, Cardiff, Belfast</li>
            <li>Postcode-area and local lists for field-sales and regional campaigns</li>
            <li>Multi-city region lists defined in the brief, not assumed</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="ed-section ed-tint" aria-labelledby="uk-companies-house">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHERE UK COMPANY DATA COMES FROM</p>
          <h2 id="uk-companies-house">The UK company registry background buyers ask about</h2>
        </div>
        <p>
          Buyers often ask where UK company data comes from. The honest answer
          starts with Companies House, the UK registrar of companies.
        </p>
      </div>
      <p>
        Limited companies and LLPs file public information there, including
        their registered office, company number and SIC codes. That public
        register is a useful background source, but it is not the whole list: a
        delivered Clean Rows file is built fresh to the brief from public and
        licensed business sources plus human review, and it shows the fields
        the buyer asked for. This page does not claim Companies House as the
        single source of every row.
      </p>
      <div class="ed-source-grid">
        <article><span class="ed-index">01</span>
          <h3>Companies House</h3>
          <p>Company search and SIC guidance for registration and classification background.</p>
          <a class="ed-inline" href="https://www.companieshouse.gov.uk/" rel="noopener">companieshouse.gov.uk ↗</a>
        </article>
        <article><span class="ed-index">02</span>
          <h3>ONS SIC 2007 pages</h3>
          <p>Industry classification, section list and code structure.</p>
          <a class="ed-inline" href="https://www.ons.gov.uk/businessandindustryoffline/insightsandanalyses/methodology/howweclassify/sic2007ukindustrialclassification" rel="noopener">ons.gov.uk ↗</a>
        </article>
        <article><span class="ed-index">03</span>
          <h3>ICO direct marketing guidance</h3>
          <p>The email rules in the compliance section below.</p>
          <a class="ed-inline" href="https://ico.org.uk/for-organisations/direct-marketing-and-privacy-and-electronic-communications/" rel="noopener">ico.org.uk ↗</a>
        </article>
      </div>
      <p class="ed-note">Sources checked 2026-10-24: ICO direct marketing and PECR guidance, Companies House SIC guidance and ONS SIC 2007 pages. No penalty or fine figure is cited on this page.</p>
    </div>
  </section>

  <section class="ed-section" aria-labelledby="uk-sample">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">WHAT THE FILE LOOKS LIKE</p>
          <h2 id="uk-sample">Sample rows: structure only</h2>
        </div>
        <p>
          These rows show the file structure of a delivered UK list. They are
          illustrative only and not real contacts.
        </p>
      </div>
      <div class="ed-table-scroll ed-table-light" role="region" aria-label="Illustrative sample rows" tabindex="0">
        <table class="ed-table ed-table-wrap">
          <caption>Illustrative sample rows, not real client data.</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Title</th>
              <th scope="col">Company type</th>
              <th scope="col">Location</th>
              <th scope="col">SIC section</th>
              <th scope="col">Email format shown in file</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Example only</td>
              <td>Head of Operations</td>
              <td>Limited company</td>
              <td>Manchester</td>
              <td>M</td>
              <td>Verified business email</td>
            </tr>
            <tr>
              <td>Example only</td>
              <td>Finance Director</td>
              <td>Limited company</td>
              <td>London</td>
              <td>K</td>
              <td>Verified business email</td>
            </tr>
            <tr>
              <td>Example only</td>
              <td>Practice Manager</td>
              <td>Limited company</td>
              <td>Edinburgh</td>
              <td>Q</td>
              <td>Verified business email</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="ed-note">
        File fields on a real delivered list: name, title, company, verified
        business email, LinkedIn URL, plus the ICP fields agreed in the brief
        (industry, size, location, and any extra requested fields).
      </p>
    </div>
  </section>

  <section class="ed-section ed-tint" aria-labelledby="uk-pricing">
    <div class="ed-wrap">
      <div class="ed-section-head">
        <div>
          <p class="ed-kicker">PRICING IN USD</p>
          <h2 id="uk-pricing">Per-package pricing, exactly as on the pricing page</h2>
        </div>
        <p>
          All prices are in USD, per package, as on the live pricing page. No
          seat fees, no subscription, no credits. The per-lead price is the
          final price for the agreed list. A free 100-lead sample comes before
          payment, one per business.
        </p>
      </div>
      <div class="ed-table-scroll ed-table-light" role="region" aria-label="Pricing table" tabindex="0">
        <table class="ed-table ed-table-wrap">
          <caption>Standard packages, in USD.</caption>
          <thead>
            <tr>
              <th scope="col">Package</th>
              <th scope="col">Price (USD)</th>
              <th scope="col">Leads</th>
              <th scope="col">Effective cost per lead</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Starter</th>
              <td>$25</td>
              <td>1,000</td>
              <td>$0.025</td>
            </tr>
            <tr>
              <th scope="row">Growth</th>
              <td>$199</td>
              <td>10,000</td>
              <td>$0.0199</td>
            </tr>
            <tr>
              <th scope="row">Scale</th>
              <td>$799</td>
              <td>50,000</td>
              <td>$0.0159</td>
            </tr>
            <tr>
              <th scope="row">Enterprise</th>
              <td>Custom quote</td>
              <td>100,000+</td>
              <td>Quoted per brief</td>
            </tr>
          </tbody>
        </table>
      </div>
      <a class="ed-inline" href="/pricing">See the full pricing page</a>
    </div>
  </section>

  <section class="ed-section ed-boundary" id="uk-compliance" aria-labelledby="uk-compliance-title">
    <div class="ed-wrap">
      <p class="ed-kicker">UK COMPLIANCE</p>
      <h2 id="uk-compliance-title">UK email rules: UK GDPR and PECR</h2>
      <p>
        This section is general information, not legal advice. Readers should
        check the ICO guidance and their own counsel before sending.
      </p>
      <p>
        UK email marketing sits under two sets of rules, and both matter.
      </p>
      <ul>
        <li>PECR (the Privacy and Electronic Communications Regulations) decides who you can send marketing email to.</li>
        <li>UK GDPR decides how you collect, store and use personal data, including a named person's work email address.</li>
      </ul>
      <h3>The distinction buyers most often get wrong: corporate versus individual subscribers</h3>
      <ul>
        <li>
          Corporate subscribers, such as limited companies, LLPs and public
          bodies, are treated differently under PECR. The strict PECR consent
          rule for unsolicited marketing email does not apply to corporate
          subscribers in the same way, but every message must still identify
          the sender, give a valid contact address, and offer a simple opt-out
          that is honoured.
        </li>
        <li>
          Individual subscribers are different. Sole traders and most
          partnerships (outside Scotland) are treated as individual subscribers
          for PECR purposes, so the stricter consent or soft opt-in rules apply
          to them. Partnerships in Scotland have separate legal personality and
          are treated as corporate subscribers, which is why entity type must
          be a field in the brief, not an assumption.
        </li>
        <li>
          A named individual at a company is still personal data under UK
          GDPR, even when PECR is more permissive for the corporate address.
          The sender still needs a lawful basis for processing that personal
          data, commonly legitimate interests supported by a documented
          legitimate interests assessment, and must respect the absolute right
          to object to direct marketing.
        </li>
        <li>
          The soft opt-in is narrow. It covers existing customers only, where
          details were collected during a sale or negotiations for a sale, the
          marketing is for the sender's own similar products or services, an
          opt-out was offered when details were collected, and every message
          offers an opt-out. It does not cover a purchased or rented list,
          because those people never gave their details to the sender
          directly.
        </li>
      </ul>
      <p>
        Practical brief rule that follows from this: never mix corporate
        subscribers and sole traders or partnerships into one send under one
        rule. Split the list by entity type in the brief, and treat any
        doubtful record as an individual subscriber unless the brief proves
        otherwise.
      </p>
      <p>
        This page is about email. Live calls, automated calls and SMS have
        their own PECR rules and preference-service checks, and they are not
        covered by this section.
      </p>
      <blockquote>
        This page gives general information about UK email rules, not legal
        advice. Email laws change and depend on your message, your audience and
        your sending setup. Check the ICO direct marketing guidance and talk to
        a lawyer before you send.
      </blockquote>
      <p class="ed-note">
        Sources checked for this section (2026-10-24): ICO guidance as
        summarised by multiple secondary sources, plus the ONS and Companies
        House SIC background above. The ICO guide itself should be linked
        directly at publish time after a direct check. No penalty or fine
        figure is cited on this page.
      </p>
    </div>
  </section>

  <section class="ed-section ed-faq" aria-labelledby="uk-faq-title">
    <div class="ed-wrap ed-split">
      <div>
        <p class="ed-kicker">STRAIGHT ANSWERS</p>
        <h2 id="uk-faq-title">UK list FAQs</h2>
        <p>
          Have a more specific brief?
          <a class="ed-inline" href="/free-sample#contact">Ask us directly.</a>
        </p>
      </div>
      <div class="ed-questions">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>
              {question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>
              <strong>
                {answer.split(". ")[0]}
                {answer.includes(". ") ? "." : ""}
              </strong>
              {answer.includes(". ")
                ? " " + answer.split(". ").slice(1).join(". ")
                : ""}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="ed-section ed-related" aria-labelledby="uk-related-heading">
    <div class="ed-wrap">
      <h2 class="ed-kicker" id="uk-related-heading">KEEP EXPLORING</h2>
      <div class="ed-related-grid">
        <a href="/pricing">
          <span aria-hidden="true">↗</span>
          <h3>UK list pricing</h3>
          <p>Packages and per-lead math.</p>
        </a>
        <a href="/free-sample">
          <span aria-hidden="true">↗</span>
          <h3>Free sample</h3>
          <p>How the 100-lead sample works.</p>
        </a>
        <a href="/calculator">
          <span aria-hidden="true">↗</span>
          <h3>Calculator</h3>
          <p>Compare pay-per-list against a subscription seat model.</p>
        </a>
        <a href="/compare/b2b-data-subscriptions">
          <span aria-hidden="true">↗</span>
          <h3>Lists vs subscriptions</h3>
          <p>Head-to-head comparisons, when a subscription fits better.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
