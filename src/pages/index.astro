        <li class="logo-item"><img src="assets/logos/hubspot.svg" alt="" width="126" height="36" loading="lazy" decoding="async"></li>
        <li class="logo-item"><img src="assets/logos/linkedin.svg" alt="" width="132" height="34" loading="lazy" decoding="async"></li>
