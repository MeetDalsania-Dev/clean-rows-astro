<section class="section" id="how"><div class="section-heading"><p class="eyebrow"><span>04</span>FROM BRIEF TO YOUR NEXT CAMPAIGN</p><h2>From ICP to prospect list in 24 hours</h2><p>Five steps. No portal to log into, no onboarding call, no implementation fee. Send your ICP and we get to work.</p></div><div class="steps-nav" role="tablist" aria-label="How it works"><button role="tab" id="step-tab-0" aria-controls="step-panel" aria-selected="true" tabindex="0" data-step="0"><span>01</span>Your ICP</button><button role="tab" id="step-tab-1" aria-controls="step-panel" aria-selected="false" tabindex="-1" data-step="1"><span>02</span>Free sample</button><button role="tab" id="step-tab-2" aria-controls="step-panel" aria-selected="false" tabindex="-1" data-step="2"><span>03</span>Verification</button><button role="tab" id="step-tab-3" aria-controls="step-panel" aria-selected="false" tabindex="-1" data-step="3"><span>04</span>Delivery</button><button role="tab" id="step-tab-4" aria-controls="step-panel" aria-selected="false" tabindex="-1" data-step="4"><span>05</span>Support</button></div><div class="step-content" role="tabpanel" id="step-panel" aria-labelledby="step-tab-0" tabindex="0"><div class="step-copy"><p class="eyebrow" id="step-time">2 MINUTES</p><h3 id="step-title">Send us your ICP</h3><p id="step-body">Tell us the roles, seniority, industries, company sizes, locations and target accounts you want to reach. Share whether your focus is LinkedIn, email, account based campaigns or a mix. We confirm what we can source before you order.</p><div class="cta-pair"><a class="button lime cta-primary" data-sample href="#contact">Get 100 free leads</a><a class="button cta-secondary" href="#pricing">Choose a plan</a></div></div><div class="step-art" aria-hidden="true"><span class="step-big" id="step-big" data-num="01" aria-hidden="true"></span><div class="step-receipt"><span id="receipt-title">YOUR IDEAL CUSTOMER</span><strong id="receipt-main">VP of Sales<br>Head of Growth</strong><p id="receipt-sub">B2B SaaS · Fintech<br>50 to 500 employees</p><div class="receipt-line"></div><span id="receipt-foot">A sentence is enough to start.</span></div></div></div><div class="glance reveal" data-glance data-stage="5" style="--s:4"><div class="glance-head"><h3 id="glance-h">All five steps at a glance</h3><p class="glance-hint" hidden aria-hidden="true"><span class="hint-drag">Drag the file to follow an order</span><span class="hint-scroll">Scroll and the file follows along</span><span class="glance-keys"><kbd>←</kbd><kbd>→</kbd></span></p></div><div class="glance-path"><input class="glance-range" type="range" min="1" max="5" step="1" value="5" hidden aria-label="Follow an order through the five steps" aria-valuetext="Step 5 of 5: Support after delivery"><div class="glance-track" aria-hidden="true"><span class="glance-spot"></span><span class="glance-puck"><svg class="glance-file" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#152b26" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="4" y="2" width="16" height="20" rx="3"/><path class="r1" d="M7.5 7.5H16.5"/><g class="g2"><path d="M7.5 11.5H16.5"/><path d="M7.5 15.5H12.5"/></g><path class="g3" d="M14.2 15.6l1.4 1.4 2.8-3"/><path class="g4" d="M10.5 5V19" stroke-width="1.2" opacity=".55"/><g class="g5"><circle cx="18.5" cy="19" r="4.5" fill="#152b26"/><g fill="#baf4ce" stroke="none"><circle cx="16.9" cy="19" r=".75"/><circle cx="18.5" cy="19" r=".75"/><circle cx="20.1" cy="19" r=".75"/></g></g></svg></span></div><ol class="glance-steps" role="list" aria-labelledby="glance-h"><li style="--i:0"><span class="glance-node" aria-hidden="true"><svg class="tick" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#152b26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg></span><div class="glance-copy"><span class="glance-tag" aria-hidden="true">01 · Your ICP</span><strong>Send us your ICP.</strong> Roles, seniority, industries, company sizes, locations and target accounts. We confirm what we can source before you order.</div></li><li style="--i:1"><span class="glance-node" aria-hidden="true"><svg class="tick" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#152b26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg></span><div class="glance-copy"><span class="glance-tag" aria-hidden="true">02 · Free sample</span><strong>Review your <span style="white-space:nowrap">100 lead</span> sample.</strong> Check profiles, job titles, companies and contact fields against your brief, then approve it or ask for changes.</div></li><li style="--i:2"><span class="glance-node" aria-hidden="true"><svg class="tick" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#152b26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg></span><div class="glance-copy"><span class="glance-tag" aria-hidden="true">03 · Verification</span><strong>We build and review your list.</strong> We research against the agreed criteria, remove duplicates, check business emails and review the file.</div></li><li style="--i:3"><span class="glance-node" aria-hidden="true"><svg class="tick" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#152b26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg></span><div class="glance-copy"><span class="glance-tag" aria-hidden="true">04 · Delivery</span><strong>Receive a CSV or Google Sheet.</strong> A structured file for your CRM or outreach tool, with custom columns and per client splits on request.</div></li><li style="--i:4"><span class="glance-node" aria-hidden="true"><svg class="tick" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="#152b26" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg></span><div class="glance-copy"><span class="glance-tag" aria-hidden="true">05 · Support</span><strong>Support after delivery.</strong> If the list does not match the agreed brief, we rebuild it free or refund you.</div></li></ol></div><span class="glance-stamp" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg>Delivered</span></div></section>
<style>
/* "Follow an order": the finished route is the default CSS state; the script only adds motion. */
.glance{--gm:"JetBrains Mono","JetBrains Mono Fallback",ui-monospace,monospace;--gh:Manrope,"Manrope Fallback",Inter,"Inter Fallback",sans-serif;grid-column:1/-1;position:relative;margin-top:72px;padding:40px 44px 44px;background:var(--ink);border-radius:14px;box-shadow:0 30px 60px -32px rgba(21,43,38,.45);color:#a9bdb1}
.glance h3{font:550 1.5rem/1.2 var(--gh);letter-spacing:-.035em;color:#f4f8f5;margin:0}
.glance-hint,.glance-tag{font:600 .6875rem/18px var(--gm);letter-spacing:.14em;text-transform:uppercase;color:#9fc2ae}
.glance-hint{display:flex;align-items:center;margin:10px 0 0}
.glance-range[hidden],.glance-hint[hidden],.hint-scroll{display:none}
.glance-keys{display:inline-flex;margin-left:8px}
.glance kbd{display:inline-grid;place-items:center;width:18px;height:18px;margin-left:4px;border:1px solid #4a6a5f;border-radius:4px;color:#dfe8e2;font:600 10px/1 var(--gm)}
.glance-path{position:relative;container-type:inline-size;margin-top:46px}
.glance-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
.glance li{--f:1;--on:1;--c:1;--nd:calc(var(--k,0)*70ms + 70ms);position:relative;padding:64px 28px 0 0}
.glance li:not(:last-child)::before,.glance li:not(:last-child)::after{content:"";position:absolute;top:21px;left:40px;right:12px;height:2px;border-radius:1px}
.glance li::before{background:repeating-linear-gradient(90deg,#3f5d53 0 6px,transparent 6px 12px)}
.glance li::after{background:#8ce8b1;transform-origin:left;transform:scaleX(var(--f));transition:transform 380ms var(--ease) calc(var(--k,0)*70ms + 40ms)}
.glance-node{position:absolute;z-index:0;top:8px;left:0;width:28px;height:28px;border:1.5px solid #56786b;border-radius:50%;display:grid;place-items:center}
.glance-node::before{content:"";grid-area:1/1;width:6px;height:6px;border-radius:50%;background:#56786b}
.glance-node::after{content:"";position:absolute;inset:-1.5px;border-radius:50%;background:#8ce8b1}
.glance-node .tick{grid-area:1/1;position:relative;z-index:1}
.glance-node::after,.glance-node .tick{opacity:var(--on);transform:scale(calc(.4 + .6*var(--on)));transition:transform 260ms cubic-bezier(.3,1.5,.5,1) var(--nd),opacity 160ms ease var(--nd)}
.glance-copy{font-size:.875rem;line-height:1.65;opacity:var(--c);transition:opacity 300ms ease var(--nd)}
.glance-tag{display:block;margin-bottom:6px}
.glance-copy strong{display:block;margin-bottom:6px;font:600 1.0625rem/1.35 var(--gh);letter-spacing:-.02em;color:#f4f8f5}
.glance-track{position:absolute;inset:0;pointer-events:none}
.glance-spot,.glance-puck{position:absolute;transform:translateX(calc(var(--s)*20cqw))}
.glance-spot{top:-14px;bottom:-16px;left:-16px;width:calc(20% + 4px);border-radius:12px;background:rgba(186,244,206,.055);border:1px solid rgba(186,244,206,.12);transition:transform 480ms var(--ease)}
.glance-puck{z-index:2;top:0;left:-8px;width:44px;height:44px;border-radius:12px;background:#baf4ce;display:grid;place-items:center;box-shadow:0 0 0 6px rgba(140,232,177,var(--ra,.14)),0 12px 24px -8px rgba(0,0,0,.45);transition:transform var(--pt,420ms) var(--ease),scale 180ms var(--ease)}
.glance-file :is(.g2 path,.g3,.g4,.g5){transform-box:fill-box;transition:transform 260ms var(--ease) 200ms,opacity 200ms ease 200ms}
.glance-file .g2 path{--x:scaleX(.15);transform-origin:left center}
.glance-file .g2 path+path{transition-delay:260ms}
.glance-file :is(.g3,.g5){--x:scale(.5);transform-origin:center}
.glance-file .g4{--x:scaleY(.15);transform-origin:center top}
.glance-stamp{position:absolute;top:38px;right:44px;display:inline-flex;align-items:center;gap:6px;padding:8px 12px 8px 10px;font:700 .75rem/1 var(--gm);letter-spacing:.2em;text-transform:uppercase;color:#8ce8b1;border:2px solid;border-radius:6px;box-shadow:inset 0 0 0 3px #152b26,inset 0 0 0 4px rgba(140,232,177,.45);transform:rotate(-6deg);transition:opacity 140ms linear,transform 300ms cubic-bezier(.2,1.5,.4,1)}
.glance-stamp::after{content:"";position:absolute;inset:-2px;border:2px solid;border-radius:6px;opacity:0}
.glance.is-burst .glance-stamp::after{animation:glance-burst 420ms var(--ease) both}
@keyframes glance-burst{from{opacity:.5}to{opacity:0;transform:scale(1.5)}}
.glance-range{position:absolute;z-index:3;top:0;left:-8px;width:calc(80% + 44px);height:44px;margin:0;padding:0;opacity:0;-webkit-appearance:none;appearance:none;background:none;cursor:grab;touch-action:pan-y}
.glance-range:active{cursor:grabbing}
.glance-range::-webkit-slider-thumb{-webkit-appearance:none;width:44px;height:44px;border:0}
.glance-range::-moz-range-thumb{width:44px;height:44px;border:0;background:none}
.glance-range:focus-visible~.glance-track .glance-puck{outline:2px solid #baf4ce;outline-offset:4px}
.glance-range:active~.glance-track .glance-puck{scale:1.08;--ra:.24}
/* Step states are screen-only, so print shows the finished route. */
@media screen{
.glance li[data-state=current]{--f:0;--on:0}
.glance li[data-state=current] .glance-tag{color:#baf4ce}
.glance li[data-state=next]{--f:0;--on:0;--c:.8;--nd:0s}
.glance li[data-state=next]::after{transition-delay:0s}
.glance[data-stage="1"] .g2 path,.glance:is([data-stage="1"],[data-stage="2"]) .g3,.glance:is([data-stage="1"],[data-stage="2"],[data-stage="3"]) .g4,.glance:not([data-stage="5"]) .g5{opacity:0;transform:var(--x);transition-delay:0s}
.glance:is([data-stage="1"],[data-stage="2"],[data-stage="3"]) .glance-stamp{opacity:0;transform:rotate(-6deg) scale(1.7);transition:opacity 120ms linear,transform 160ms ease}
}
@media (hover:hover){
.glance-range:hover~.glance-track .glance-puck{--ra:.22}
.glance li[data-state=next]:hover{--c:1}
.is-live .glance li{cursor:pointer}
}
@media (min-width:1081px) and (max-width:1240px){
.glance{padding-inline:36px}
.glance li{padding-right:20px}
.glance-stamp{right:36px}
}
/* Tablet and phone: a vertical route and scrolling moves the file. */
@media (max-width:1080px){
.glance{margin-top:48px;padding:28px 20px 76px}
.glance h3{font-size:1.375rem}
.hint-drag,.glance-keys,.no-scrub .glance-hint,.glance:not(.is-live) .glance-puck,.glance-range,.glance-spot{display:none}
.hint-scroll{display:inline}
.glance-path{margin-top:28px}
.glance-steps{grid-template-columns:minmax(0,1fr)}
.glance li{padding:6px 0 28px 48px}
.glance li:last-child{padding-bottom:0}
.glance-node{top:0}
.glance-copy{max-width:60ch}
.glance li:not(:last-child)::before,.glance li:not(:last-child)::after{top:36px;bottom:8px;left:13px;width:2px;height:auto}
.glance li::before{background:repeating-linear-gradient(180deg,#3f5d53 0 6px,transparent 6px 12px)}
.glance li::after{transform-origin:center top;transform:scaleY(var(--f))}
.glance-puck{left:-6px;width:40px;height:40px;border-radius:11px;transform:translateY(calc(var(--y,0px) - 6px))}
.glance-stamp{top:auto;bottom:22px;right:20px;transform-origin:right center}
}
@media (max-width:360px){.glance-hint{font-size:.625rem;letter-spacing:.1em}}
.glance--instant *,.glance--instant *::before,.glance--instant *::after{transition:none!important;animation:none!important}
@media (prefers-reduced-motion:reduce){.glance *,.glance *::before,.glance *::after{transition:none!important;animation:none!important}}
@media print{.glance{background:none;border:1px solid var(--line);box-shadow:none;color:#4a5a54}.glance h3,.glance-copy strong{color:var(--ink)}.glance-tag{color:#4c6358}.glance-stamp{color:var(--green);box-shadow:none}.glance-node::after,.glance li::after{-webkit-print-color-adjust:exact;print-color-adjust:exact}.glance-puck,.glance-spot,.glance-range,.glance-hint{display:none!important}}
@media (forced-colors:active){
.glance-node{border-color:CanvasText}
.glance-node::before,.glance-node::after,.glance li::after{forced-color-adjust:none;background:CanvasText}
.glance-node .tick{forced-color-adjust:none;stroke:Canvas}
.glance-puck{border:2px solid CanvasText}
}
</style>
<script>
  // "Follow an order": one value n (1-5) drives the route. Without JS the card stays in its finished state.
  const g = document.querySelector('#how .glance');
  if (g) {
    const input = g.querySelector('.glance-range');
    const lis = [...g.querySelectorAll('.glance-steps > li')];
    const wide = matchMedia('(min-width:1081px)');
    const io = 'IntersectionObserver' in window;
    const motion = io && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.documentElement.classList.contains('motion-paused');
    let n = 5, timers = [], runIO, scrubIO = [];
    const place = () => { if (!wide.matches) g.style.setProperty('--y', lis[n - 1].offsetTop + 'px'); };
    const set = v => {
      const p = n;
      n = Math.min(5, Math.max(1, v));
      g.dataset.stage = n;
      g.style.setProperty('--s', n - 1);
      g.style.setProperty('--pt', 300 + 120 * Math.max(1, Math.abs(n - p)) + 'ms');
      lis.forEach((li, i) => {
        li.dataset.state = i < n - 1 ? 'done' : i > n - 1 ? 'next' : 'current';
        li.style.setProperty('--k', n > p ? Math.max(0, i - p + 1) : 0);
      });
      input.value = n;
      input.setAttribute('aria-valuetext', `Step ${n} of 5: ${lis[n - 1].querySelector('strong').textContent.replace(/\.$/, '')}`);
      if (n < 4) g.classList.remove('is-burst'); else if (p < 4) g.classList.add('is-burst');
      place();
    };
    const stop = () => { timers.forEach(clearTimeout); timers = []; runIO?.disconnect(); };
    const mode = first => {
      stop();
      scrubIO.forEach(o => o.disconnect());
      if (wide.matches) {
        if (!first || !motion || g.getBoundingClientRect().top <= innerHeight) return set(n);
        // Desktop: hop 01 -> 05 once, when the route is well in view.
        set(1);
        runIO = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          runIO.disconnect();
          const hop = () => { set(n + 1); if (n < 5) timers.push(setTimeout(hop, 620)); };
          timers.push(setTimeout(hop, 600));
        }, { threshold: .55 });
        runIO.observe(g.querySelector('.glance-path'));
      } else if (motion) {
        // Tablet and phone: the last step whose top has passed a reading line at 45% of the viewport is current.
        // It is read from positions (re-checked when a step crosses the line or the card enters or leaves the
        // viewport), so a fast fling or an anchor jump past the card still lands on the right step.
        const sync = () => { let v = 1; lis.forEach((li, i) => { if (li.getBoundingClientRect().top < innerHeight * .46) v = i + 1; }); set(v); };
        sync();
        scrubIO = [new IntersectionObserver(sync, { rootMargin: '-45% 0px -54% 0px' }), new IntersectionObserver(sync)];
        lis.forEach(li => scrubIO[0].observe(li));
        scrubIO[1].observe(g);
      } else set(n);
    };

    g.classList.add('glance--instant', 'is-live');
    g.classList.toggle('no-scrub', !motion);
    input.hidden = g.querySelector('.glance-hint').hidden = false;
    mode(true);
    input.addEventListener('input', () => { stop(); set(+input.value); });
    input.addEventListener('pointerdown', stop);
    input.addEventListener('keydown', stop);
    lis.forEach((li, i) => li.addEventListener('click', () => {
      if (getSelection()?.isCollapsed === false) return;
      stop();
      set(i + 1);
    }));
    wide.addEventListener('change', () => mode(false));
    addEventListener('resize', () => requestAnimationFrame(place), { passive: true });
    document.fonts?.ready.then(place);
    document.fonts?.addEventListener('loadingdone', place);

    // Transitions switch on only after the card has rendered, so the set-up state never animates.
    const arm = () => requestAnimationFrame(() => requestAnimationFrame(() => g.classList.remove('glance--instant')));
    if (io) {
      const seen = new IntersectionObserver(([e]) => { if (e.isIntersecting) { seen.disconnect(); arm(); } });
      seen.observe(g);
    } else arm();
  }
</script>
