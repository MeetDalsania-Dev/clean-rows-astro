---
import InlineLinks from "./InlineLinks.astro";
interface PanelProps {
  fileName: string;
  subline: string;
  rows: { initials: string; title: string }[];
  chips: string[];
}
interface Props {
  label: string;
  title: string;
  accent: string;
  description: string;
  cta?: string;
  href?: string;
  secondary?: string;
  secondaryHref?: string;
  note?: string;
  proof?: string;
  noPanel?: boolean;
  panelLabel?: string;
  panelTitle?: string;
  items?: string[][];
  filePanel?: PanelProps;
  strip?: { strong: string; sub: string }[];
}
const {
  label,
  title,
  accent,
  description,
  cta = "Get 100 free leads",
  href = "#contact",
  secondary = "See how it works",
  secondaryHref = "#approach",
  note = "Pay as you go · No seat fees · Freshly sourced",
  proof,
  noPanel = false,
  panelLabel = "YOUR CAMPAIGN BRIEF",
  panelTitle = "A better starting point.",
  items = [],
  filePanel,
  strip,
} = Astro.props;
const avatarClasses = ["a0", "a1", "a2"];
---

<section class="ed-hero" id="top">
  <div class="ed-wrap">
    <nav class="ed-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{label}</span>
    </nav>
    <div class="ed-hero-grid">
      <div>
        <p class="ed-kicker">
          <span></span>
          {label}
        </p>
        <h1>{title}</h1>
        <p class="ed-accent">{accent}</p>
        <p class="ed-intro"><InlineLinks text={description} /></p>
        <div class="ed-actions">
          <a class="ed-button ed-primary" href={href}>
            {cta}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="ed-text-link" href={secondaryHref}>
            {secondary}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        {proof && <p class="ed-proof">{proof}</p>}
        {note && !proof && <p class="ed-note">{note}</p>}
      </div>
      {!noPanel && filePanel && (
      <aside class="ed-filecard" aria-label={`${filePanel.fileName} preview`}>
        <div class="ed-filecard-bar">
          <span class="ed-file-symbol" aria-hidden="true">▤</span>
          <div>
            <strong>{filePanel.fileName}</strong>
            <span>{filePanel.subline}</span>
          </div>
          <span class="ed-file-menu" aria-hidden="true">•••</span>
        </div>
        <div class="ed-filecard-rows">
          {filePanel.rows.map((row, i) => (
            <div>
              <span class={`avatar ${avatarClasses[i % 3]}`} aria-hidden="true">{row.initials}</span>
              <strong>{row.title}</strong>
              <span class="ed-row-check" aria-label="Included" aria-hidden="true">✓</span>
            </div>
          ))}
        </div>
        <div class="ed-filecard-chips">
          {filePanel.chips.map((chip) => (
            <span>✓ {chip}</span>
          ))}
        </div>
      </aside>
      )}
      {!noPanel && !filePanel && (
      <aside class="ed-brief" aria-label={panelLabel}>
        <div class="ed-brief-bar">
          <span class="ed-dots" aria-hidden="true">
            ● ● ●
          </span>
          <span>CLEAN ROWS / RESEARCH DESK</span>
        </div>
        <div class="ed-brief-body">
          <p class="ed-kicker">{panelLabel}</p>
          <p class="ed-brief-title">{panelTitle}</p>
          <dl>
            {items.map(([key, value]) => (
              <div>
                <dt>{key}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
          <div class="ed-brief-foot">
            <span class="ed-status" aria-hidden="true"></span>Define the
            audience. Review the fit.
          </div>
        </div>
      </aside>
      )}
    </div>
  </div>
  {strip && strip.length > 0 && (
  <div class="ed-wrap">
    <div class="ed-strip" aria-label="What every list includes">
      {strip.map((item) => (
        <div>
          <span class="ed-strip-icon" aria-hidden="true">✓</span>
          <div>
            <strong>{item.strong}</strong>
            {item.sub && <p>{item.sub}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
  )}
</section>
