---
const { items } = Astro.props;
---

<section class="ed-section ed-related" aria-labelledby="related-heading">
  <div class="ed-wrap">
    <h2 class="ed-kicker" id="related-heading">KEEP EXPLORING</h2>
    <div class="ed-related-grid">
      {items.map(([href, title, text]) => (
        <a href={href}>
          <span aria-hidden="true">↗</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </a>
      ))}
    </div>
  </div>
</section>
