---
// "Struck from the list": the section edits its own audience the way Clean Rows edits data.
// Poster-scale "NOT for", a ruled exclusion table with a pen strike through each persona,
// and a mint-highlighted row that stays. Motion rides the global .reveal/.in-view hook;
// the finished layout is the base CSS (no-JS and reduced-motion visitors see it at rest).
---
<section class="section paper wnf" id="who-not-for" aria-labelledby="wnf-title">
  <div class="wnf-head reveal">
    <div class="wnf-headline">
      <p class="eyebrow wnf-eyebrow wnf-f"><span><svg aria-hidden="true" focusable="false" width="23" height="23" viewBox="0 0 23 23" fill="none"><path d="M3.6 19.4 19.4 3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>FULL TRANSPARENCY</p>
      <h2 id="wnf-title" class="wnf-title"><span class="wnf-t1 wnf-f">Who Clean Rows is</span> <span class="wnf-t2"><span class="wnf-mask"><span class="wnf-not wnf-s">NOT</span></span> <span class="wnf-mask"><span class="wnf-for wnf-s">for</span></span></span></h2>
    </div>
    <div class="wnf-aside wnf-f">
      <p class="wnf-file" aria-hidden="true"><i></i><i></i><i></i><span>not-a-fit.csv</span><small>3 ROWS</small></p>
      <p class="wnf-intro">We are a bespoke data boutique, not a bulk database dump. If you fall into any of these categories, we are proudly not the right fit for you.</p>
    </div>
  </div>

  <ol class="wnf-list" role="list">
    <li class="wnf-row reveal" style="--i:0">
      <span class="wnf-num" aria-hidden="true"><span class="wnf-s">01</span></span>
      <h3 class="wnf-h"><span class="wnf-k wnf-f">The</span> <span class="wnf-label wnf-f"><span class="wnf-q">“</span>Quantity over Quality<span class="wnf-q">”</span></span> <span class="wnf-k wnf-f">buyer</span></h3>
      <p class="wnf-body wnf-f">If you just want 1,000,000 random emails to blast from a burner domain for $5, we cannot help you. <strong class="wnf-verdict wnf-f">We focus on high-ticket, highly targeted outreach.</strong></p>
    </li>
    <li class="wnf-row reveal" style="--i:1">
      <span class="wnf-num" aria-hidden="true"><span class="wnf-s">02</span></span>
      <h3 class="wnf-h"><span class="wnf-k wnf-f">The</span> <span class="wnf-label wnf-f"><span class="wnf-q">“</span>B2C / Consumer<span class="wnf-q">”</span></span> <span class="wnf-k wnf-f">marketer</span></h3>
      <p class="wnf-body wnf-f">We do not source, scrape, or sell consumer data, personal emails (like Gmail/Yahoo), or physical home addresses. <strong class="wnf-verdict wnf-f">Strictly B2B.</strong></p>
    </li>
    <li class="wnf-row reveal" style="--i:2">
      <span class="wnf-num" aria-hidden="true"><span class="wnf-s">03</span></span>
      <h3 class="wnf-h"><span class="wnf-k wnf-f">The</span> <span class="wnf-label wnf-f"><span class="wnf-q">“</span>Instant Export<span class="wnf-q">”</span></span> <span class="wnf-k wnf-f">seeker</span></h3>
      <p class="wnf-body wnf-f">If you cannot wait 24 hours for a human-verified, clean file and need an instant, unverified download, use a software tool. <strong class="wnf-verdict wnf-f">We build lists fresh to order.</strong></p>
    </li>
  </ol>

  <div class="wnf-kept reveal">
    <span class="wnf-check" aria-hidden="true"><svg focusable="false" width="22" height="22" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <p class="wnf-kept-k wnf-f">What stays on the list</p>
    <p class="wnf-kept-t wnf-f">High-ticket, targeted B2B outreach, built fresh to order and human-verified.</p>
    <a class="button lime cta-primary wnf-cta" data-sample href="#contact">Get 100 free leads <span aria-hidden="true">↗︎</span></a>
  </div>
</section>

<style>
.wnf{--d:0s;--dl:0s;--t:.7s;--wm:"JetBrains Mono","JetBrains Mono Fallback",monospace;--wh:Manrope,"Manrope Fallback",sans-serif}
.wnf-head{display:grid;grid-template-columns:1fr 340px;gap:64px;align-items:end;margin-bottom:64px;overflow-x:clip}
.wnf-title{max-width:none;font-size:clamp(30px,3.3vw,46px);line-height:1.08}
.wnf-t1,.wnf-t2{display:block}
.wnf-t2{margin:.03em 0 0 -.065em;font-size:clamp(140px,14.6vw,232px);line-height:.92;letter-spacing:-.06em}
.wnf-mask,.wnf-num{display:inline-block;vertical-align:top;padding:.08em .1em .04em 0;margin:-.08em -.1em -.04em 0}
.wnf-s{display:inline-block}
.wnf-not{font-weight:680}
.wnf-for{font-weight:250;color:var(--green)}
.wnf-aside{padding-bottom:22px}
.wnf-file{display:flex;align-items:center;gap:8px;margin:0 0 18px;padding-bottom:12px;border-bottom:1px solid var(--line);font:12px/1.4 var(--wm);color:var(--muted)}
.wnf-file i{width:6px;height:6px;border-radius:50%;background:#cfdcd4}
.wnf-file small{margin-left:auto;font-size:11px;letter-spacing:.1em}
.wnf-intro{margin:0;font-size:16.5px;line-height:1.75;color:var(--muted);text-wrap:pretty}
.wnf-list{list-style:none;margin:0;padding:0;border-bottom:2px solid var(--ink)}
.wnf-row{--d:calc(var(--i,0)*180ms);position:relative;display:grid;grid-template-columns:148px 1.2fr 1fr;gap:48px;align-items:start;padding:40px 0 44px}
.wnf-row::before,.wnf-kept::before,.wnf-label::after,.wnf-verdict::before{content:"";transform-origin:left}
.wnf-row::before{position:absolute;inset:0 0 auto;height:1px;background:var(--line)}
.wnf-row:first-child::before{height:2px;background:var(--ink)}
.wnf-num{margin-top:-.14em;margin-left:-.06em;font:200 clamp(72px,7.4vw,108px)/.9 var(--wh);letter-spacing:-.06em;color:var(--green)}
.wnf-h{display:grid;grid-template-columns:auto auto 1fr;gap:14px 8px;justify-items:start}
/* small caps: h3 name stays sentence case */
.wnf-k,.wnf-kept-k{font:600 16.4px/1 var(--wm);font-variant-caps:all-small-caps;letter-spacing:.085em;color:var(--muted)}
.wnf-label{grid-area:2/1/auto/-1;position:relative;margin-left:-.38em;font-size:clamp(28px,3.3vw,48px);line-height:1.08;letter-spacing:-.045em}
.wnf-q{color:var(--muted)}
.wnf-label::after{position:absolute;left:-.04em;right:-.04em;top:55%;height:max(2px,.06em);border-radius:2px;background:#c4694f}
.wnf-body{margin:0;padding-left:32px;border-left:1px solid var(--line);line-height:1.75;color:var(--muted);text-wrap:pretty}
.wnf-verdict{display:block;margin-top:16px;padding-left:34px;text-indent:-34px;font:550 19px/1.4 var(--wh);letter-spacing:-.02em;color:var(--ink);text-wrap:balance}
.wnf-verdict::before{display:inline-block;width:22px;height:2px;margin-right:12px;vertical-align:.32em;background:var(--green)}
.wnf-kept{position:relative;isolation:isolate;display:grid;grid-template-columns:115px 1fr auto;grid-template-areas:"c k a" "c t a";gap:8px 48px;align-items:center;margin-top:32px;padding:28px 32px;border:1px solid #bfe8cf;border-radius:14px}
.wnf-kept::before{position:absolute;inset:0;z-index:-1;border-radius:inherit;background:var(--mint)}
.wnf-check{grid-area:c;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--green);color:#fff}
.wnf-kept-k{grid-area:k;align-self:end;margin:0;color:#2f5a45}
.wnf-kept-t{grid-area:t;align-self:start;margin:0;font:550 clamp(21px,2.6vw,28px)/1.25 var(--wh);letter-spacing:-.035em;text-wrap:balance}
.wnf-cta{grid-area:a;min-height:48px;padding:12px 18px;gap:12px;justify-content:center;white-space:nowrap}
.wnf-cta:focus-visible{outline-color:var(--ink)}
@media (max-width:1180px){
.wnf-head{display:block}
.wnf-aside{max-width:540px;margin-top:32px;padding:0}
.wnf-t2{font-size:clamp(72px,27vw,232px)}
.wnf-row{grid-template-columns:88px 1fr;gap:18px 28px}
.wnf-num{grid-row:span 2;font-size:68px}
.wnf-label{font-size:clamp(30px,4.6vw,44px)}
.wnf-body{max-width:62ch;padding:0;border:0}
.wnf-kept{grid-template-columns:64px 1fr;grid-template-areas:"c k" "c t" ". a";column-gap:28px;padding:24px}
.wnf-check{width:44px;height:44px}
.wnf-cta{justify-self:start;margin-top:12px}
}
@media (max-width:640px){
.wnf-head{margin-bottom:44px}
.wnf-title{font-size:clamp(26px,7.7vw,34px)}
.wnf-t2{font-size:clamp(72px,27vw,180px)}
.wnf-aside{margin-top:28px}
.wnf-row{display:block;padding:28px 0 32px}
.wnf-num{display:block;font-size:56px;margin-bottom:14px}
.wnf-label{font-size:clamp(24px,7.6vw,32px)}
.wnf-body{margin-top:16px;line-height:1.7}
.wnf-verdict{margin-top:14px;font-size:17.5px}
.wnf-kept{grid-template-columns:40px 1fr;grid-template-areas:"c k" "t t" "a a";column-gap:16px;align-items:start;margin-top:24px;padding:20px}
.wnf-kept-k{align-self:center}
.wnf-check{width:40px;height:40px}
.wnf-kept-t{font-size:20px;line-height:1.3}
.wnf-cta{width:100%;justify-content:space-between;margin-top:14px}
}
/* Motion: hidden states only with JS + motion; .in-view releases them */
:global(.js) .wnf .reveal{opacity:1;transform:none;transition:none}
@media (prefers-reduced-motion:no-preference){
:global(.js) :is(.wnf-mask,.wnf-num){overflow:hidden}
.wnf-eyebrow{--y:14px}
.wnf-t1{--y:14px;--dl:60ms}
.wnf-aside{--y:12px;--dl:.42s}
.wnf-t2{--t:1.05s}
.wnf-not{--dl:.14s}
.wnf-for{--dl:.23s}
.wnf-row::before{--t:.9s}
.wnf-num>span{--t:.9s;--dl:80ms}
.wnf-k{--y:8px;--t:.5s;--dl:.18s}
.wnf-label{--y:18px;--t:.8s;--dl:.22s}
.wnf-body{--y:12px;--dl:.34s}
.wnf-label::after{--t:.56s;--e:cubic-bezier(.7,0,.2,1);--dl:.82s}
.wnf-verdict::before{--t:.4s;--dl:1.04s}
.wnf-verdict{--y:0;--x:-10px;--t:.6s;--dl:1.08s}
.wnf-kept-k{--x:-12px;--dl:.2s}
.wnf-kept-t{--x:-12px;--dl:.28s}
.wnf-kept::before{--t:1s;--dl:.56s}
:global(.js) .wnf-f{opacity:0;transform:translate(var(--x,0),var(--y,0))}
.wnf .in-view .wnf-f{opacity:1;transform:none;transition:opacity var(--t) var(--ease) calc(var(--d) + var(--dl)),transform var(--t) var(--ease) calc(var(--d) + var(--dl))}
:global(.js) .wnf-s{transform:translateY(102%)}
.wnf .in-view .wnf-s{transform:none;transition:transform var(--t) cubic-bezier(.16,1,.3,1) calc(var(--d) + var(--dl))}
:global(.js) .wnf-row::before,:global(.js) .wnf-kept::before,:global(.js) .wnf-label::after,:global(.js) .wnf-verdict::before{transform:scaleX(0)}
.wnf .in-view::before,.wnf .in-view .wnf-label::after,.wnf .in-view .wnf-verdict::before{transform:none;transition:transform var(--t) var(--e,var(--ease)) calc(var(--d) + var(--dl))}
:global(.js) .wnf-check{opacity:0;transform:scale(.5)}
.wnf .in-view .wnf-check{opacity:1;transform:none;transition:opacity .4s var(--ease) 1s,transform .6s cubic-bezier(.34,1.56,.64,1) 1s}
}
@media (forced-colors:active){
.wnf-label::after,.wnf-verdict::before,.wnf-row::before{forced-color-adjust:none;background:CanvasText}
.wnf-check{forced-color-adjust:none;background:CanvasText;color:Canvas}
/* no backplate over the line above */
.wnf-t2{forced-color-adjust:none;color:CanvasText}
.wnf-for{color:inherit}
}
</style>
