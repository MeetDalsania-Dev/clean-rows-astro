---
export interface Props {
  competitorName: string;
}
const { competitorName } = Astro.props;
---
<section class="section paper" id="compare">
  <div class="section-heading">
    <p class="eyebrow"><span>⚖️</span> THE HONEST COMPARISON</p>
    <h2>Clean Rows vs {competitorName}</h2>
    <p>We are not trying to be a massive software platform. If you need a live searchable database your whole team logs into, {competitorName} is great. But if you need clean, verified lists delivered directly to your inbox, we are more cost-effective.</p>
  </div>
  <p class="table-hint" id="comparison-scroll-hint">Swipe or scroll sideways to compare →</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Provider comparison" aria-describedby="comparison-scroll-hint" style="margin-top: 2rem;">
    <table>
      <thead>
        <tr>
          <th>What matters</th>
          <th>Clean Rows</th>
          <th>{competitorName}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>Entry price</th>
          <td>$25 / 1,000 leads</td>
          <td>See their pricing page</td>
        </tr>
        <tr>
          <th>Charges per seat</th>
          <td>Never</td>
          <td>Yes</td>
        </tr>
        <tr>
          <th>Annual contract</th>
          <td>None (Pay as you go)</td>
          <td>Often required</td>
        </tr>
        <tr>
          <th>Data source</th>
          <td>Sourced fresh for each order</td>
          <td>Shared database</td>
        </tr>
        <tr>
          <th>Human verification</th>
          <td>Included before delivery</td>
          <td>Automated only</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
