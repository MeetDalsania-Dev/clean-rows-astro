---
const plans = [
  {
    name: "Starter",
    badge: "",
    for: "Start your next campaign",
    price: "$25",
    volume: "1,000 verified leads",
    rate: "$25.00 per 1,000 leads",
    features: [
      "Standard prospect and company fields",
      "Built to your agreed ICP",
      "CSV or Google Sheet"
    ],
    ctaText: "Choose this plan",
    dataPlan: "1000",
    featured: false
  },
  {
    name: "Growth",
    badge: "SAVE 20%",
    for: "For growing outbound campaigns",
    price: "$199",
    volume: "10,000 verified leads",
    rate: "$19.90 per 1,000 leads",
    features: [
      "Standard prospect and company fields",
      "Built to your agreed ICP",
      "Email + WhatsApp support"
    ],
    ctaText: "Choose this plan",
    dataPlan: "10000",
    featured: false
  },
  {
    name: "Scale",
    badge: "SAVE 36%",
    for: "For agencies and larger campaigns",
    price: "$799",
    volume: "50,000 verified leads",
    rate: "$15.98 per 1,000 leads",
    features: [
      "Standard prospect and company fields",
      "Built to your agreed ICP",
      "Delivery schedule agreed upfront",
      "Per-client file splits on request",
      "Direct WhatsApp support"
    ],
    ctaText: "Choose this plan",
    dataPlan: "50000",
    featured: true
  },
  {
    name: "Enterprise",
    badge: "TAILORED QUOTE",
    for: "For larger or recurring orders",
    price: "Custom",
    volume: "100,000+ leads",
    rate: "Quoted for your volume and scope",
    features: [
      "Recurring delivery options",
      "Pricing agreed before you order",
      "Direct support for your project",
      "Quality criteria agreed upfront"
    ],
    ctaText: "Request a quote",
    dataPlan: "100000+",
    featured: false
  }
];
---

<section class="section" id="pricing">
  <div class="section-heading">
    <p class="eyebrow"><span>06</span>ONE-TIME PACKAGES. NO SEAT FEES.</p>
    <h2>Pay per list. Never per seat.</h2>
    <p>Choose a package for your campaign. Every plan includes ICP-based targeting, personal and company LinkedIn profiles, company details and verified business emails. Review 100 free leads before your first paid order.</p>
  </div>

  <div class="price-grid" id="plan-options">
    {plans.map((plan) => (
      <article class={`price-card reveal ${plan.featured ? 'featured' : ''}`}>
        <div class="plan-top">
          <h3>{plan.name}</h3>
          <span>{plan.badge}</span>
        </div>
        <p>{plan.for}</p>
        <strong class="plan-price">{plan.price}</strong>
        <span class="plan-volume">{plan.volume}</span>
        <p class="unit-rate">{plan.rate}</p>
        
        <ul>
          {plan.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>

        <a 
          class="button plan-choice" 
          href="#contact" 
          data-plan={plan.dataPlan} 
          aria-label={`Choose ${plan.name}: ${plan.volume} for ${plan.price}`}
        >
          {plan.ctaText} <span aria-hidden="true">↗︎</span>
        </a>
      </article>
    ))}
  </div>

  <p class="payment">
    All prices are in USD, per package. 
    <span>Rounded savings compare the per-lead rate with Starter. Phone numbers are included where available. We confirm your targeting, required fields and delivery date before payment. Specialist research or additional fields may require a custom quote.</span>
  </p>

  <p class="payment">
    Bank transfer · PayPal · Wise · Remitly 
    <span>No subscription or automatic renewal. Paid packages start at 1,000 leads.</span>
  </p>

  <div class="section-cta">
    <p>Review the fit before choosing a paid list. <strong>Your first 100 leads are free.</strong></p>
    <div class="cta-pair">
      <a class="button lime cta-primary" data-sample href="#contact">Get 100 free leads</a>
      <a class="button cta-secondary" href="#plan-options">Choose a plan</a>
    </div>
  </div>
</section>